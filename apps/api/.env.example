# Google Sign-In (audience). Gerçek Client ID'ler Google Cloud Console'dan.
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=

# ── eLogo e-Belge (e-Arşiv / e-Fatura) entegrasyonu ──────────────────────────
# Entegrasyon açık mı? (true → fatura akışları eLogo'ya gönderir)
ELOGO_ENABLED=false
# SOAP client modu: stub (gerçek çağrı yok) | live (gerçek eLogo servisi)
ELOGO_SOAP_MODE=stub
# PostBoxService endpoint. Canlı: pb.elogo.com.tr | Test: betatest.elogo.com.tr/webservice/PostBoxService.svc
ELOGO_SOAP_URL=https://pb.elogo.com.tr/PostBoxService.svc
# Web servis kimlikleri (eLogo panelinde oluşturulan "Bağlantı (Web Servis) Kullanıcısı")
# ⚠️ Portal e-posta/şifresinden FARKLI. Kullanıcı Kodu + o kullanıcıya özel şifre.
ELOGO_WS_USERNAME=
ELOGO_WS_PASSWORD=
# SOAP timeout (ms)
ELOGO_SOAP_TIMEOUT_MS=30000
# (Stub) e-Fatura mükellefi sayılacak VKN'ler — virgülle ayrılmış
ELOGO_STUB_EINVOICE_VKNS=
# Tarodan gelir faturaları (Katman B) — düzenleyen firma (Serhatlar Ltd) bilgisi
ELOGO_COMPANY_VKN=
ELOGO_COMPANY_TITLE=
ELOGO_COMPANY_TAXOFFICE=
ELOGO_COMPANY_CITY=
ELOGO_COMPANY_DISTRICT=
ELOGO_COMPANY_ADDRESS=
ELOGO_COMPANY_EMAIL=
# Belge numarası ön eki (eLogo portalinde tanımlı) + e-Arşiv görsel tasarım UUID'i
ELOGO_INVOICE_PREFIX=TRD
ELOGO_INVOICE_XSLT_UUID=
# KDV oranı (%) ve saklanan tutarlar KDV dahil mi (true=gross → matrah geri hesaplanır)
ELOGO_VAT_RATE=20
ELOGO_AMOUNTS_INCLUDE_VAT=true

# ── Sürat Kargo entegrasyonu ─────────────────────────────────────────────────
# Entegrasyon açık mı? (true → sipariş/iade akışları Sürat'a gerçekten gönderi oluşturur)
SURAT_CARGO_ENABLED=false
# Client modu: rest (dokümandaki REST GonderiyiKargoyaGonder — ÖNERİLEN) |
#              soap (eski webservices.asmx SOAP) | stub (gerçek çağrı yok)
SURAT_SOAP_MODE=rest
# Test ortamı mı? true → api02 (test), false → api01 (canlı).
# Hem gönderi oluşturma (REST) hem de kargo takip aynı bayrağı kullanır.
SURAT_KARGO_TEST_MODE=true
# Sürat'ın verdiği "Kullanıcı Adı" (cari kodu) ve "Şifre"
SURAT_KARGO_CARI_KODU=
SURAT_KARGO_SIFRE=
# (Opsiyonel) çağrı zaman aşımı ve retry ayarları
SURAT_SOAP_TIMEOUT_MS=15000
SURAT_CARGO_MAX_RETRIES=3
SURAT_CARGO_RETRY_BASE_MS=200
