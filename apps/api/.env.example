# =============================================================================
# Tarodan API — environment template
#
# `pnpm dev` copies this file to apps/api/.env when the local file is missing,
# so every value below must be safe for local development.
#
# Production values live in Coolify and are validated at startup by
# src/config/env.validation.ts. A key that is NOT declared in that zod schema is
# stripped when it arrives from a .env file and silently falls back to its code
# default — if you add a variable here, add it to the schema too.
#
# Legend:  [prod-required]  boot fails in production without it
#          [script]         read by seed/bootstrap/smoke scripts, not the server
#          [test]           read by the test harness only
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime & process
# -----------------------------------------------------------------------------
NODE_ENV=development
# [prod-required when NODE_ENV=production] staging | production. Drives S3
# prefix, search index isolation and the PayTR/Sürat live-mode guards.
APP_ENV=
PORT=3001
# all | web | worker — 'web' serves HTTP, 'worker' drains queues/crons.
PROCESS_ROLE=all
# Print the full route table at boot (noisy).
NEST_VERBOSE_ROUTES=false
# Swagger UI at /api/docs. Keep false in production.
ENABLE_SWAGGER=true

# -----------------------------------------------------------------------------
# URLs, CORS and cookies
# -----------------------------------------------------------------------------
# Do NOT append /api — the app adds it. A trailing /api produces …/api/api/… links.
API_URL="http://localhost:3001"
FRONTEND_URL="http://localhost:3000"
# Optional canonical public URL; falls back to FRONTEND_URL when empty.
APP_URL=
CORS_ORIGINS="http://localhost:3000,http://localhost:3002"
COOKIE_DOMAIN=
COOKIE_SECURE=false
# Next.js on-demand revalidation hook (web app).
WEB_REVALIDATE_URL=http://localhost:3000
REVALIDATE_SECRET=
# Public URL of the logo used in email templates. Empty falls back to
# FRONTEND_URL/tarodan-logo.jpg, which mail clients cannot fetch on localhost.
EMAIL_LOGO_URL="https://tarodan.com.tr/tarodan-logo.jpg"

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tarodan?schema=public"

# -----------------------------------------------------------------------------
# Redis — cache AND queues. Deployments use two separate instances.
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Elasticsearch
# -----------------------------------------------------------------------------
ELASTICSEARCH_NODE="http://localhost:9200"
# Alias for ELASTICSEARCH_NODE; either one is accepted.
ELASTICSEARCH_URL=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
# Optional override. Deployed environments derive it from APP_ENV, producing
# staging-products / production-products even on a shared cluster. Never write
# the opposite environment's name here — the two would share one index.
ELASTICSEARCH_INDEX_PREFIX=

# -----------------------------------------------------------------------------
# Authentication & secrets
# Generate strong values for production: openssl rand -base64 32
# All five secrets must be present and mutually distinct in production.
# -----------------------------------------------------------------------------
JWT_SECRET="tarodan-jwt-secret-key-change-in-production-2024"
JWT_REFRESH_SECRET="tarodan-refresh-secret-key-change-in-production-2024"
ADMIN_JWT_SECRET="tarodan-admin-jwt-secret-change-in-production-2024"
PAYMENT_CAPABILITY_SECRET="tarodan-payment-capability-change-in-production"
GUEST_CHECKOUT_OTP_SECRET="tarodan-guest-otp-secret-change-in-production-2024"
# Existing encrypted 2FA records depend on this key. Never rotate it without a
# migration plan and a backup.
TWO_FACTOR_ENCRYPTION_KEY="tarodan-two-factor-encryption-key-local-development"

JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
ADMIN_JWT_EXPIRES_IN="1h"
ADMIN_JWT_REFRESH_EXPIRES_IN="7d"
# Guest checkout OTP lifetime, seconds.
GUEST_CHECKOUT_OTP_TTL_SEC=600

# -----------------------------------------------------------------------------
# OAuth / social sign-in
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_SERVICES_ID=

# -----------------------------------------------------------------------------
# Object storage (AWS S3 or S3-compatible)
# MinIO is not used; storage goes through AWS S3.
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
S3_BUCKET=
# Local=dev, staging=staging, production=prod. Never share a prefix between
# deployed environments; startup validation rejects staging paired with prod.
S3_ENV_PREFIX=dev
# Public read base URL (CDN or bucket website endpoint). Empty derives from bucket.
S3_PUBLIC_BASE_URL=
# Optional custom S3-compatible endpoint. Leave empty for AWS S3.
S3_ENDPOINT=

# =============================================================================
# PAYMENT PROVIDER — PayTR
#
# Iyzico is NOT used. PayTR is the only provider; legacy IYZICO_* variables have
# no consumer in the codebase — do not add them.
# =============================================================================

# Credentials: https://www.paytr.com/ — the code trims, but avoid stray spaces.
PAYTR_MERCHANT_ID=your-paytr-merchant-id
PAYTR_MERCHANT_KEY=your-paytr-merchant-key
PAYTR_MERCHANT_SALT=your-paytr-merchant-salt
# Test store: true | 1 | yes. Live: false | 0. Must match the PayTR panel.
# [prod-required] must be literally 'false' in production; staging must be true.
PAYTR_TEST_MODE=true
# The exact notification URL configured in the PayTR panel. Empty means the app
# expects {API_URL}/api/payments/callback/paytr. Locally, expose it with ngrok:
# https://xxxx.ngrok-free.app/api/payments/callback/paytr
PAYTR_CALLBACK_URL=
# HTTP timeout (ms) — stops a hung fetch from blocking checkout.
PAYTR_HTTP_TIMEOUT_MS=20000

# --- Missed-callback reconciliation (durum-sorgu) ---
PAYTR_RECONCILIATION_ENABLED=true
PAYTR_RECONCILIATION_MIN_AGE_MINUTES=3
PAYTR_RECONCILIATION_BATCH_LIMIT=40
# Amount-mismatch tolerance in TL — callback, reconciliation and verification
# all read this single threshold.
PAYTR_RECONCILE_AMOUNT_TOLERANCE_TL=0.05
# How far back the orphan-payment sweep looks, in hours.
PAYTR_ORPHAN_LOOKBACK_HOURS=72
# Forged-callback amplification bound, per merchant_oid.
PAYTR_HASH_MISMATCH_MAX_PER_WINDOW=5
PAYTR_HASH_MISMATCH_WINDOW_SEC=60

# --- Card vault / recurring (PayTR Direct API) ---
# Cards are stored only at PayTR; the app keeps utoken/ctoken plus masked
# metadata. Do not enable without confirmed Card Storage API access.
PAYTR_CARD_STORAGE_ENABLED=false
# Unattended membership renewal. Requires separately granted Non3D +
# recurring_payment access. While false, processAutoRenewals only sends
# reminders and charges nothing.
PAYTR_RECURRING_ENABLED=false

# --- Panel-gated features. Keep closed at launch. ---
# Payout transfer-result webhook. Enabling it before the panel URL
# (/api/payouts/callback/paytr-transfer) is registered blocks every payout.
PAYTR_TRANSFER_CALLBACK_ENABLED=false
# Settlement/statement report sync — needs report permission on the panel.
PAYTR_REPORT_SYNC_ENABLED=false

# -----------------------------------------------------------------------------
# Payment / escrow / payout behaviour
# -----------------------------------------------------------------------------
# Development only: complete payments without PayTR. Production refuses to boot
# when this is true.
PAYMENT_BYPASS=false
# Unpaid reservation timeout, minutes.
PAYMENT_TIMEOUT_MINUTES=5
# How long a failed payment stays retryable before the order is dropped, minutes.
PAYMENT_FAIL_TIMEOUT_MINUTES=35
# Escrow hold period, days.
PAYMENT_HOLD_DAYS=7
# Seller preparation/handover deadline, days; exceeding it auto-cancels + refunds.
PREPARING_DEADLINE_DAYS=3
# 48-hour buyer confirmation window (does not release the hold at delivery).
FEATURE_48H_CONFIRMATION_WINDOW=false
# Set true on staging to block real, irreversible bank transfers.
# [prod-required] must be literally 'false' in production, 'true' in staging.
PAYOUTS_DISABLED=false
# Days between payout eligibility and the actual transfer.
PAYOUT_GRACE_DAYS=1
# Ledger reconciliation look-back window, days.
LEDGER_RECONCILE_WINDOW_DAYS=2

# -----------------------------------------------------------------------------
# Offers
# -----------------------------------------------------------------------------
OFFER_EXPIRY_HOURS=24
# Lowest acceptable offer as a percentage of the listing price.
MIN_OFFER_PERCENTAGE=50

# =============================================================================
# SURAT CARGO
#
# Two independent switches (SURAT_SOAP_MODE is a legacy variable name):
#   SURAT_SOAP_MODE       rest=official create+tracking; stub=no network
#   SURAT_KARGO_TEST_MODE picks the host — true=api02 (test), false=api01 (live)
# Both default to the SAFE value, so a missing variable never ships live.
# =============================================================================

SURAT_CARGO_ENABLED=false
# rest (official GonderiyiKargoyaGonder + KargoTakipHareketDetayi, required in
# production) | stub (local only, no network). live/soap are rejected.
SURAT_SOAP_MODE=rest
# [prod-required] must be 'false' in production, 'true' in staging.
SURAT_KARGO_TEST_MODE=true
SURAT_KARGO_CARI_KODU=
SURAT_KARGO_SIFRE=
SURAT_SOAP_TIMEOUT_MS=15000
# Takip endpoint'i için ayrı timeout; boşsa SURAT_SOAP_TIMEOUT_MS kullanılır.
SURAT_TRACKING_TIMEOUT_MS=20000
SURAT_CARGO_MAX_RETRIES=3
SURAT_CARGO_RETRY_BASE_MS=200

# Stub-mode fault injection (local/unit tests only). Leave empty.
SURAT_STUB_RESPONSE=
SURAT_STUB_KARGO_TAKIP_NO=
SURAT_STUB_THROW=

# -----------------------------------------------------------------------------
# Shipping policy & tracking alerts
# -----------------------------------------------------------------------------
CARGO_PICKUP_NO_DATA_DAYS=2
CARGO_STALE_MOVEMENT_DAYS=3
SHIPPED_STALE_ALERT_DAYS=10
# Inbound carrier webhook endpoint. Keep closed at launch.
SHIPPING_WEBHOOK_ENABLED=false

# Return warehouse printed on the shipping label. When unset, the label falls
# back to placeholder text ("Tarodan Merkez Depo Adresi / Maltepe / 05000000000").
# The admin Warehouse tab does NOT cover these — they are env-only.
TARODAN_WAREHOUSE_NAME=
TARODAN_WAREHOUSE_PHONE=
TARODAN_WAREHOUSE_CITY=
TARODAN_WAREHOUSE_DISTRICT=
TARODAN_WAREHOUSE_ADDRESS=

# -----------------------------------------------------------------------------
# Order lifecycle & returns
# -----------------------------------------------------------------------------
RETURN_WINDOW_DAYS=14
REFUND_RETURN_DROPOFF_DAYS=3
REFUND_RETURN_INSPECTION_HOURS=48
REFUND_WAIT_DELIVERY_MAX_DAYS=30
# Trade lost-parcel auto-resolution: a shipped-to-warehouse trade whose parcel
# never arrives is auto-cancelled (with tracked refund + compensation flag)
# this many days after its shipping deadline.
TRADE_LOST_PARCEL_GRACE_DAYS=14
# Production rollout gate for immutable component-based refund settlement.
REFUND_POLICY_V2_ENABLED=false

# =============================================================================
# ELOGO E-DOCUMENT (e-Arşiv / e-Fatura)
#
# Unlike PayTR and Sürat there is NO test flag. ELOGO_SOAP_MODE=live only means
# "make a real SOAP call"; whether it reaches the GİB production pipeline
# depends entirely on ELOGO_SOAP_URL plus the credentials. Note the default URL
# below is the LIVE endpoint — point it at the demo host for integration tests.
#
# Invoice numbers advance gap-free (GİB requirement): every document issued
# permanently consumes a number in the sequence, cancellation included.
# =============================================================================

ELOGO_ENABLED=false
# stub (local, no network) | live (real SOAP call)
# [prod-required] must be 'live' in production.
ELOGO_SOAP_MODE=stub
# Live: https://pb.elogo.com.tr/PostBoxService.svc
# Demo: https://pb-demo.elogo.com.tr/PostboxService.svc  (separate credentials)
# Test: https://betatest.elogo.com.tr/webservice/PostBoxService.svc
ELOGO_SOAP_URL=https://pb.elogo.com.tr/PostBoxService.svc
ELOGO_WS_USERNAME=
ELOGO_WS_PASSWORD=
ELOGO_SOAP_TIMEOUT_MS=30000
# Log the full SOAP envelope. Never enable in production — it contains credentials.
ELOGO_DEBUG=false

# Stub-mode helpers (local/unit tests only). Leave empty.
ELOGO_STUB_EINVOICE_VKNS=
ELOGO_STUB_THROW=

# --- Tarodan as the invoice issuer (printed on every document) ---
ELOGO_COMPANY_VKN=
ELOGO_COMPANY_TITLE=
ELOGO_COMPANY_TAXOFFICE=
ELOGO_COMPANY_CITY=
ELOGO_COMPANY_DISTRICT=
ELOGO_COMPANY_ADDRESS=
ELOGO_COMPANY_EMAIL=
ELOGO_INVOICE_PREFIX=TRD
ELOGO_INVOICE_XSLT_UUID=
ELOGO_VAT_RATE=20

# Invoice deadlines, days.
INVOICE_DEADLINE_DAYS=5
SELLER_INVOICE_DEADLINE_DAYS=7
# TTF font for PDF rendering. Empty falls back to system fonts, then Helvetica.
INVOICE_FONT_PATH=

# -----------------------------------------------------------------------------
# Outbox (transactional event dispatch)
# -----------------------------------------------------------------------------
OUTBOX_DRAIN_BATCH_LIMIT=50
OUTBOX_BACKOFF_BASE_MS=10000
OUTBOX_BACKOFF_CAP_MS=3600000
OUTBOX_STALE_PROCESSING_MS=300000

# =============================================================================
# EMAIL (SMTP only, via nodemailer)
#
# SMTP_HOST is the on/off switch: while empty the app still boots and every mail
# is logged as [EMAIL-MOCK] instead of being sent. Production additionally
# requires SMTP_USER/SMTP_PASS or boot fails.
# =============================================================================

# Local development: Mailpit (starts with `pnpm dev`, UI at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="Tarodan <no-reply@tarodan.local>"

# Production: tarodan.com.tr mail hosting (akıllıticaret).
# All outbound mail is sent as info@tarodan.com.tr — the relay requires the From
# address to match the authenticated account, so do not send as destek@.
# SMTP_HOST=mail.akilliticaret.com
# SMTP_PORT=587
# SMTP_USER=info@tarodan.com.tr
# SMTP_PASS=
# SMTP_SECURE=false
# MAIL_FROM="Tarodan <info@tarodan.com.tr>"

# Set true once the mail host is confirmed to present a certificate matching
# SMTP_HOST. Left false, a mismatched certificate is tolerated so STARTTLS still
# upgrades the connection instead of aborting it.
# SMTP_TLS_REJECT_UNAUTHORIZED=false

# Legacy relays. Node 20 (OpenSSL 3) refuses anything below TLSv1.2 and fails
# STARTTLS with "ssl_choose_client_version: unsupported protocol". Prefer pinning
# the older version to keep the session encrypted; only skip STARTTLS entirely if
# the host cannot negotiate any version, because then the password crosses the
# network in the clear.
# SMTP_MIN_TLS_VERSION=TLSv1
# SMTP_IGNORE_TLS=false

# Optional SendGrid API key (alternative transport).
SENDGRID_API_KEY=

# destek@tarodan.com.tr is a RECIPIENT only (contact-form notifications) and the
# address shown in email footers. Nothing is ever sent from this account.
SUPPORT_EMAIL=destek@tarodan.com.tr
SUPPORT_NOTIFICATION_EMAIL=destek@tarodan.com.tr

# -----------------------------------------------------------------------------
# SMS & push notifications
# -----------------------------------------------------------------------------
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_MSGHEADER=
NETGSM_BASE_URL=https://api.netgsm.com.tr

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Expo push notifications (mobile app).
EXPO_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# AI moderation (local Python service: services/ai-moderation)
# While disabled the system behaves as before: products stay pending and
# messages are screened by regex.
# -----------------------------------------------------------------------------
AI_MODERATION_ENABLED=false
AI_MODERATION_URL=http://localhost:8000
AI_MODERATION_TIMEOUT_MS=20000

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
# Sentry — empty disables error tracking.
SENTRY_DSN=
LOG_LEVEL=info
# json for structured logs (recommended in deployments); empty = pretty printing.
LOG_FORMAT=

# Bull Board queue UI. Disabled unless explicitly enabled; keep false in production.
BULLBOARD_ENABLED=false
BULLBOARD_USER=
BULLBOARD_PASS=

# =============================================================================
# [script] Seed, bootstrap and smoke tooling
# Not read by the running server. Supplied ad hoc by CI / operators.
# =============================================================================

# Corporate seller opened by the launch seed (16-72 bytes).
LAUNCH_SELLER_EMAIL=
LAUNCH_SELLER_PASSWORD=
# Display name for the bootstrapped super admin.
BOOTSTRAP_ADMIN_DISPLAY_NAME=
# Media seeding: source prefix, image skip, and the production safety override.
SEED_ASSETS_PREFIX=
SEED_SKIP_IMAGES=
SEED_MEDIA_ALLOW_PROD=
# Alternate bucket variable honoured by the media seed script.
AWS_S3_BUCKET=
# Post-launch verification smoke run.
PRODUCTION_LAUNCH_SMOKE_BASE_URL=
SMOKE_DEBUG=
SMOKE_NON3D=
SMOKE_USER_IP=
# eLogo PDF fetch helper script.
ELOGO_PDF_OUT=
ELOGO_PDF_UUID=
ELOGO_TEST_VKN=

# =============================================================================
# [test] Test harness only
# =============================================================================

TEST_DATABASE_URL=
# Throttling is disabled during tests unless this is 'true'.
TEST_THROTTLING_ENABLED=
# Admin app base URL used by e2e journeys.
ADMIN_URL="http://localhost:3002"
# Shared secret for the shipping webhook e2e scenario.
SURAT_WEBHOOK_SECRET=
# Local mail catcher UI polled by tests.
MAILPIT_URL=http://localhost:8025
MAILHOG_URL=http://localhost:8025
