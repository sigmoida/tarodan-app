# Tarodan API environment template.
# `pnpm dev` copies this file to apps/api/.env when the local file is missing.
# Values below are development-only placeholders. Production values belong in
# Coolify and are validated by src/config/env.validation.ts at startup.

# Database (PostgreSQL)
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE?schema=public
# For local development with Docker: postgresql://postgres:postgres@localhost:5432/tarodan?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tarodan?schema=public"

# JWT Authentication
# Generate strong secrets for production: openssl rand -base64 32
JWT_SECRET="tarodan-jwt-secret-key-change-in-production-2024"
JWT_REFRESH_SECRET="tarodan-refresh-secret-key-change-in-production-2024"
ADMIN_JWT_SECRET="tarodan-admin-jwt-secret-change-in-production-2024"
PAYMENT_CAPABILITY_SECRET="tarodan-payment-capability-change-in-production"
GUEST_CHECKOUT_OTP_SECRET="tarodan-guest-otp-secret-change-in-production-2024"
# Existing encrypted 2FA records depend on this key. Never rotate it without a
# migration plan and backup.
TWO_FACTOR_ENCRYPTION_KEY="tarodan-two-factor-encryption-key-local-development"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
ADMIN_JWT_EXPIRES_IN="1h"
ADMIN_JWT_REFRESH_EXPIRES_IN="7d"

# Server Configuration
PORT=3001
NODE_ENV=development
PROCESS_ROLE=all
API_URL="http://localhost:3001"
FRONTEND_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3002"
CORS_ORIGINS="http://localhost:3000,http://localhost:3002"
COOKIE_DOMAIN=
COOKIE_SECURE=false
ENABLE_SWAGGER=true

# Redis (for caching and queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# AI Moderasyon (lokal Python servisi: services/ai-moderation)
# Kapalıyken (false) sistem bugünkü gibi çalışır: ürün pending kalır, mesaj regex'e göre.
AI_MODERATION_ENABLED=false
AI_MODERATION_URL=http://localhost:8000
AI_MODERATION_TIMEOUT_MS=20000

# Elasticsearch (for search functionality)
ELASTICSEARCH_NODE="http://localhost:9200"

# AWS S3 Configuration (Object Storage - images, avatars, documents)
# MinIO kullanılmıyor; depolama AWS S3 (veya S3 uyumlu servis) üzerinden yapılır.
# Get your credentials from: https://console.aws.amazon.com/iam/
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
S3_BUCKET=
# Local=dev, staging=staging, production=prod. Never share prefixes between
# deployed environments; startup validation rejects staging with prod.
S3_ENV_PREFIX=dev
# Set only when a seed without S3 media is intentionally required (for example CI).
SEED_SKIP_IMAGES=
# Opsiyonel: S3 uyumlu özel endpoint (örn. MinIO self-hosted). AWS S3 için boş bırakın.
# S3_ENDPOINT=http://localhost:9000

# Google Sign-In
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_SECRET=

# =============================================================================
# PAYMENT PROVIDERS
# =============================================================================

# Iyzico KULLANILMIYOR — Tarodan tek ödeme sağlayıcısı olarak PayTR kullanır.
# (Eski IYZICO_* değişkenlerinin kodda tüketicisi yoktur; eklemeyin.)

# PayTR Direct API
# Credentials: https://www.paytr.com/ — panelden kopyalarken başta/sonda boşluk kalmasın (kod trim eder).
PAYTR_MERCHANT_ID=your-paytr-merchant-id
PAYTR_MERCHANT_KEY=your-paytr-merchant-key
PAYTR_MERCHANT_SALT=your-paytr-merchant-salt
# Test mağazası: true | 1 | yes (canlı: false | 0). Panel ile uyumlu olmalı.
PAYTR_TEST_MODE=true
# Opsiyonel: PayTR panelindeki Bildirim URL tam adresi (log için). Boşsa API şu yolu bekler: {API_URL}/api/payments/callback/paytr
# Yerelde PayTR’nin dışarıdan erişebilmesi için ngrok vb. kullanın, örn. https://xxxx.ngrok-free.app/api/payments/callback/paytr
PAYTR_CALLBACK_URL=
# PayTR HTTP istek zaman aşımı (ms) — fetch'in askıda kalmasını önler.
PAYTR_HTTP_TIMEOUT_MS=20000

# --- Ödeme / Escrow / Payout davranışı ---
# Geliştirme/test: PayTR olmadan ödeme. Prod'da (NODE_ENV=production) true ise uygulama başlamaz.
PAYMENT_BYPASS=false
# Ödeme sonrası satıcı hazırlama/kargo süresi (gün); aşılırsa otomatik iptal + iade.
PREPARING_DEADLINE_DAYS=3
# Ödenmemiş rezervasyon/ödeme zaman aşımı (dakika).
PAYMENT_TIMEOUT_MINUTES=5
# 48 saat alıcı onay penceresi (teslimatta hold'u anında bırakmaz).
FEATURE_48H_CONFIRMATION_WINDOW=false
# Kaçırılan callback'leri yakalamak için PayTR durum-sorgu mutabakatı.
PAYTR_RECONCILIATION_ENABLED=true
PAYTR_RECONCILIATION_MIN_AGE_MINUTES=3
PAYTR_RECONCILIATION_BATCH_LIMIT=40
# Tutar uyuşmazlığı toleransı (TL) — callback/mutabakat/doğrulama tek eşik kullanır.
PAYTR_RECONCILE_AMOUNT_TOLERANCE_TL=0.05
# Staging'de gerçek (geri alınamaz) banka transferini engellemek için true yapın.
PAYOUTS_DISABLED=false

# --- PayTR Direct API kart kasası / recurring ---
# Kartlar yalnız PayTR'da saklanır; uygulama DB'sinde utoken/ctoken ve maskeli
# metadata tutulur. PayTR Kart Saklama API yetkisi doğrulanmadan açmayın.
PAYTR_CARD_STORAGE_ENABLED=false
# Kullanıcısız otomatik üyelik yenileme. PayTR'den Non3D + recurring_payment
# yetkisi ayrıca alınıp doğrulanmadan true yapmayın.
# false iken processAutoRenewals cron'u hiçbir gerçek çekim yapmaz (yalnız hatırlatma).
PAYTR_RECURRING_ENABLED=false
# Başarısız recurring çekimde maksimum deneme sayısı (dunning), sonra üyelik free'ye düşer.
PAYTR_RECURRING_MAX_RETRIES=3

# =============================================================================
# SURAT CARGO
# =============================================================================

SURAT_CARGO_ENABLED=false
# rest (recommended/live barcode API) | soap (legacy) | stub (local only)
SURAT_SOAP_MODE=rest
# true uses api02 test endpoints; production requires false.
SURAT_KARGO_TEST_MODE=true
SURAT_KARGO_CARI_KODU=
SURAT_KARGO_SIFRE=
SURAT_SOAP_TIMEOUT_MS=15000
SURAT_CARGO_MAX_RETRIES=3
SURAT_CARGO_RETRY_BASE_MS=200

# Tracking and return policy defaults
CARGO_PICKUP_NO_DATA_DAYS=2
CARGO_STALE_MOVEMENT_DAYS=3
REFUND_RETURN_DROPOFF_DAYS=3
REFUND_RETURN_INSPECTION_HOURS=48
REFUND_WAIT_DELIVERY_MAX_DAYS=30

# Return warehouse
TARODAN_WAREHOUSE_NAME=
TARODAN_WAREHOUSE_PHONE=
TARODAN_WAREHOUSE_CITY=
TARODAN_WAREHOUSE_DISTRICT=
TARODAN_WAREHOUSE_ADDRESS=

# =============================================================================
# ELOGO E-DOCUMENT
# =============================================================================

ELOGO_ENABLED=false
# stub (local) | live (production)
ELOGO_SOAP_MODE=stub
ELOGO_SOAP_URL=https://pb.elogo.com.tr/PostBoxService.svc
ELOGO_WS_USERNAME=
ELOGO_WS_PASSWORD=
ELOGO_SOAP_TIMEOUT_MS=30000
ELOGO_STUB_EINVOICE_VKNS=

# Tarodan invoice issuer
ELOGO_COMPANY_VKN=
ELOGO_COMPANY_TITLE=
ELOGO_COMPANY_TAXOFFICE=
ELOGO_COMPANY_CITY=
ELOGO_COMPANY_DISTRICT=
ELOGO_COMPANY_ADDRESS=
ELOGO_COMPANY_EMAIL=
ELOGO_INVOICE_PREFIX=TRD
ELOGO_INVOICE_XSLT_UUID=
ELOGO_VAT_RATE=20
ELOGO_AMOUNTS_INCLUDE_VAT=true

# =============================================================================
# EMAIL CONFIGURATION
# Admin panelinden "E-posta Şablonları" > Test gönder çalışsın istiyorsanız
# SMTP_HOST, SMTP_USER, SMTP_PASS mutlaka doldurulmalı. Boşsa mailler sadece log'a yazılır.
# =============================================================================

# Gmail SMTP (Recommended for development)
# 1. Enable 2-Step Verification on your Google account
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
# 3. Use the generated app password (16 characters) as SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here
MAIL_FROM="your-email@gmail.com"
SMTP_SECURE=false
SENDGRID_API_KEY=

# Alternative: Mailpit (Local development email testing)
# Starts with `pnpm dev`; UI: http://localhost:8025
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="noreply@tarodan.com"

# Alternative: SendGrid (Production)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key
# MAIL_FROM="noreply@yourdomain.com"

# =============================================================================
# BUSINESS LOGIC
# =============================================================================

# Payment Hold (Escrow period in days)
PAYMENT_HOLD_DAYS=7

# Admin Panel
ADMIN_SESSION_TIMEOUT=1800

# Web cache revalidation
WEB_REVALIDATE_URL=http://localhost:3000
REVALIDATE_SECRET=

# Bull Board is disabled unless explicitly enabled.
BULLBOARD_ENABLED=false
BULLBOARD_USER=
BULLBOARD_PASS=

# =============================================================================
# LOGGING & ERROR TRACKING
# =============================================================================

# Sentry (opsiyonel — boşsa hata izleme kapalı)
SENTRY_DSN=
LOG_LEVEL=info
