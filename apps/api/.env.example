# apps/api environment template.
#
# Local setup:  cp apps/api/.env.example apps/api/.env  (then adjust as needed).
# `.env` is gitignored — never commit real secrets. The previously committed
# `env.txt` was removed (#62); this template documents every required var.
#
# The secrets below are DEV-ONLY placeholders. In production the startup
# validator (src/config/env.validation.ts) requires every secret to be set,
# >= 32 chars, mutually distinct, and free of the word "change-in-production" —
# the app fail-fasts at boot otherwise. Set real production secrets via the
# deploy environment, not this file.

# ── Core (required to boot) ──────────────────────────────────────────────────
# Database (matches infrastructure/docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tarodan?schema=public"

# Auth secrets — ALL required; each realm uses its own, there is no cross-fallback.
JWT_SECRET="dev-user-jwt-secret-local-only-override-me-0001"
JWT_REFRESH_SECRET="dev-refresh-jwt-secret-local-only-override-me-0002"
ADMIN_JWT_SECRET="dev-admin-jwt-secret-local-only-override-me-0003"
GUEST_CHECKOUT_OTP_SECRET="dev-guest-otp-pepper-local-only-override-me-0004"

JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
ADMIN_JWT_EXPIRES_IN="15m"
ADMIN_JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV=development
API_URL="http://localhost:3001"
FRONTEND_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3002"

# Redis (matches docker-compose.yml)
REDIS_HOST=localhost
REDIS_PORT=6379

# Elasticsearch (matches docker-compose.yml)
ELASTICSEARCH_NODE="http://localhost:9200"

# Payment - PayTR (test credentials here; REQUIRED in production)
PAYTR_MERCHANT_ID="test-merchant"
PAYTR_MERCHANT_KEY="test-key"
PAYTR_MERCHANT_SALT="test-salt"

# AWS S3 (use your own local credentials; provided via secrets in production)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="eu-central-1"
S3_BUCKET=""
S3_ENV_PREFIX="dev"

# ── Integrations ─────────────────────────────────────────────────────────────
# Google Sign-In (audience). Gerçek Client ID'ler Google Cloud Console'dan.
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=
# Web auth-code flow için Web client'ın secret'ı (backend code→id_token takası).
# Sadece web akışında gerekir; boşsa web Google girişi 401 döner.
GOOGLE_CLIENT_SECRET=

# ── eLogo e-Belge (e-Arşiv / e-Fatura) entegrasyonu ──────────────────────────
# Entegrasyon açık mı? (true → fatura akışları eLogo'ya gönderir)
ELOGO_ENABLED=false
# SOAP client modu: stub (gerçek çağrı yok) | live (gerçek eLogo servisi)
ELOGO_SOAP_MODE=stub
# PostBoxService endpoint. Canlı: pb.elogo.com.tr | Test: betatest.elogo.com.tr/webservice/PostBoxService.svc
ELOGO_SOAP_URL=https://pb.elogo.com.tr/PostBoxService.svc
# Web servis kimlikleri (eLogo panelinde oluşturulan "Bağlantı (Web Servis) Kullanıcısı")
# ⚠️ Portal e-posta/şifresinden FARKLI. Kullanıcı Kodu + o kullanıcıya özel şifre.
ELOGO_WS_USERNAME=
ELOGO_WS_PASSWORD=
# SOAP timeout (ms)
ELOGO_SOAP_TIMEOUT_MS=30000
# (Stub) e-Fatura mükellefi sayılacak VKN'ler — virgülle ayrılmış
ELOGO_STUB_EINVOICE_VKNS=
# Tarodan gelir faturaları (Katman B) — düzenleyen firma (Serhatlar Ltd) bilgisi
ELOGO_COMPANY_VKN=
ELOGO_COMPANY_TITLE=
ELOGO_COMPANY_TAXOFFICE=
ELOGO_COMPANY_CITY=
ELOGO_COMPANY_DISTRICT=
ELOGO_COMPANY_ADDRESS=
ELOGO_COMPANY_EMAIL=
# Belge numarası ön eki (eLogo portalinde tanımlı) + e-Arşiv görsel tasarım UUID'i
ELOGO_INVOICE_PREFIX=TRD
ELOGO_INVOICE_XSLT_UUID=
# KDV oranı (%) ve saklanan tutarlar KDV dahil mi (true=gross → matrah geri hesaplanır)
ELOGO_VAT_RATE=20
ELOGO_AMOUNTS_INCLUDE_VAT=true

# ── Sürat Kargo entegrasyonu ─────────────────────────────────────────────────
# Entegrasyon açık mı? (true → sipariş/iade akışları Sürat'a gerçekten gönderi oluşturur)
SURAT_CARGO_ENABLED=false
# Client modu: rest (dokümandaki REST GonderiyiKargoyaGonder — ÖNERİLEN) |
#              soap (eski webservices.asmx SOAP) | stub (gerçek çağrı yok)
SURAT_SOAP_MODE=rest
# Test ortamı mı? true → api02 (test), false → api01 (canlı).
# Hem gönderi oluşturma (REST) hem de kargo takip aynı bayrağı kullanır.
SURAT_KARGO_TEST_MODE=true
# Sürat'ın verdiği "Kullanıcı Adı" (cari kodu) ve "Şifre"
SURAT_KARGO_CARI_KODU=
SURAT_KARGO_SIFRE=
# (Opsiyonel) çağrı zaman aşımı ve retry ayarları
SURAT_SOAP_TIMEOUT_MS=15000
SURAT_CARGO_MAX_RETRIES=3
SURAT_CARGO_RETRY_BASE_MS=200
