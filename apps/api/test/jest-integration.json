{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "test/integration/.*\\.integration-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "tsconfig.json" }]
  },
  "setupFiles": ["<rootDir>/test/test-utils/load-env-integration.ts"],
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/src/$1",
    "^@tarodan/i18n$": "<rootDir>/../../packages/i18n/src/index.ts",
    "^@tarodan/i18n/(.*)$": "<rootDir>/../../packages/i18n/src/$1.ts"
  },
  "testTimeout": 30000,
  "maxWorkers": 1,
  "verbose": true
}
