DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tarodan_test?schema=public&connection_limit=25&pool_timeout=30"

JWT_SECRET="test-jwt-secret"
JWT_REFRESH_SECRET="test-refresh-secret"
# ADMIN_JWT_SECRET intentionally equals JWT_SECRET in tests. The e2e factory
# (createAdminUser) mints ONE admin token, but admin endpoints are guarded two
# ways: @Roles on the regular JwtAuthGuard (verifies JWT_SECRET) and the
# admin-jwt strategy (verifies ADMIN_JWT_SECRET). A single token can only satisfy
# both if the two secrets match here. Secret DISTINCTNESS is a production concern
# only — validateEnv enforces it when NODE_ENV=production (and it is unit-tested
# in env.validation.spec.ts), so keeping them equal in the test env is safe.
ADMIN_JWT_SECRET="test-jwt-secret"
GUEST_CHECKOUT_OTP_SECRET="test-guest-checkout-otp-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
ADMIN_JWT_EXPIRES_IN="30m"
ADMIN_JWT_REFRESH_EXPIRES_IN="7d"
COOKIE_DOMAIN=

PORT=0
NODE_ENV=test
API_URL="http://localhost:0"
FRONTEND_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3002"

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

ELASTICSEARCH_NODE="http://localhost:9200"

AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=eu-west-1
S3_BUCKET=test-bucket

# Mock providers (overridden in tests via DI)
PAYTR_MERCHANT_ID=test-merchant
PAYTR_MERCHANT_KEY=test-key
PAYTR_MERCHANT_SALT=test-salt
SURAT_USERNAME=test
SURAT_PASSWORD=test
SURAT_CUSTOMER_CODE=000
SURAT_KARGO_CARI_KODU=test
SURAT_KARGO_SIFRE=test

# Disable cron auto-fire in tests; we invoke schedulers manually.
DISABLE_CRON=true

# Force the real (mocked) PayTR codepath in tests rather than the dev bypass.
PAYMENT_BYPASS=false
SURAT_SOAP_MODE=stub
SURAT_STUB_RESPONSE=Tamam
SURAT_CARGO_ENABLED=true
SURAT_WEBHOOK_SECRET=test-webhook-secret

# E2E: mailleri Mailhog'a yolla (docker-compose, SMTP 1025 / UI 8025) — gerçek okuma için
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@tarodan.test