{
  "name": "@tarodan/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "postbuild": "prisma generate",
    "build:seed": "rimraf dist-seed && tsc -p tsconfig.seed.json && node -e \"require('fs').cpSync('prisma/data','dist-seed/prisma/data',{recursive:true})\"",
    "seed:prod": "node dist-seed/prisma/seed.js",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "predev": "prisma generate",
    "dev": "nest start --watch",
    "prestart:dev": "prisma generate",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:worker": "node dist/worker",
    "start:worker:dev": "nest start --watch --entryFile worker",
    "railway:deploy": "prisma migrate deploy && node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "typecheck:src": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "test:e2e:setup": "dotenv -e .env.test -- prisma migrate deploy",
    "test:e2e:reset": "dotenv -e .env.test -- prisma migrate reset --force --skip-seed",
    "test:integration": "jest --config ./test/jest-integration.json --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:reset": "prisma migrate reset --force",
    "prisma:migrate:reset:local": "node scripts/run-local-prisma.mjs reset",
    "prisma:push": "prisma db push",
    "prisma:seed": "prisma db seed",
    "prisma:seed:local": "node scripts/run-local-prisma.mjs seed",
    "prisma:studio": "prisma studio",
    "seed:edge:auth": "ts-node -r tsconfig-paths/register prisma/seed-edge/auth-states.ts",
    "add-images": "ts-node -r tsconfig-paths/register scripts/add-images-to-products.ts",
    "seed:assets:build": "dotenv -e .env -- ts-node -r tsconfig-paths/register scripts/build-seed-assets.ts",
    "fix-premium-trade": "ts-node -r tsconfig-paths/register scripts/fix-premium-trade.ts",
    "fix-user-membership": "ts-node -r tsconfig-paths/register scripts/fix-user-membership.ts",
    "release-reserved": "ts-node -r tsconfig-paths/register scripts/release-reserved-products.ts",
    "diagnose-discounts": "ts-node -r tsconfig-paths/register scripts/diagnose-discounts.ts",
    "migrate-reserved-to-quantity-based": "ts-node -r tsconfig-paths/register scripts/migrate-reserved-to-quantity-based.ts",
    "temp:concurrent-buy": "ts-node -r tsconfig-paths/register scripts/temp-concurrent-buy-now.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "@aws-sdk/s3-request-presigner": "^3.1085.0",
    "@bull-board/api": "^8.1.2",
    "@bull-board/express": "^8.1.2",
    "@elastic/elasticsearch": "^8.19.2",
    "@nestjs/apollo": "^12.2.0",
    "@nestjs/bull": "^10.0.1",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/graphql": "^12.2.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/platform-socket.io": "^10.3.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^7.1.17",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^10.3.0",
    "@prisma/client": "^5.7.1",
    "@sentry/node": "^8.55.2",
    "@tarodan/i18n": "workspace:*",
    "@tarodan/logger": "workspace:*",
    "@tarodan/types": "workspace:*",
    "apollo-server-express": "^3.13.0",
    "apple-signin-auth": "^1.7.3",
    "bcrypt": "^6.0.0",
    "bull": "^4.12.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^4.22.2",
    "file-type": "^16.5.4",
    "google-auth-library": "^10.9.0",
    "graphql": "^16.14.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "nodemailer": "^9.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.19.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "0.34.5",
    "uuid": "^9.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.0.3",
    "@nestjs/testing": "^10.3.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^3.0.13",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29.7.0",
    "prettier": "^3.9.5",
    "prisma": "^5.7.1",
    "rimraf": "^5.0.5",
    "socket.io": "^4.6.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.2"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "packages/i18n/src/catalog/.+\\.json$": "<rootDir>/../test/jest-json-default-transform.js",
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@tarodan/i18n$": "<rootDir>/../../../packages/i18n/src/index.ts",
      "^@tarodan/types$": "<rootDir>/../../../packages/types/src/index.ts",
      "^@tarodan/logger$": "<rootDir>/../../../packages/logger/src/index.ts"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
