{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"],
      "@tarodan/i18n": ["../../packages/i18n/src"],
      "@tarodan/i18n/*": ["../../packages/i18n/src/*"],
      "@tarodan/types": ["../../packages/types/src"],
      "@tarodan/types/*": ["../../packages/types/src/*"],
      "@tarodan/logger": ["../../packages/logger/src"],
      "@tarodan/logger/*": ["../../packages/logger/src/*"]
    }
  },
  "include": ["src/**/*", "prisma/**/*"],
  "exclude": ["node_modules", "dist"]
}
