generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                   @id @default(uuid())
  adminCode               String                   @unique @default(dbgenerated("generate_user_admin_code('B'::text)")) @map("admin_code")
  username                String                   @unique @default(dbgenerated("generate_legacy_username()"))
  usernameClaimedAt       DateTime?                @map("username_claimed_at")
  email                   String                   @unique
  phone                   String?                  @unique
  passwordHash            String?                  @map("password_hash")
  displayName             String                   @map("display_name")
  avatarUrl               String?                  @map("avatar_url")
  bio                     String?
  isVerified              Boolean                  @default(false) @map("is_verified")
  isEmailVerified         Boolean                  @default(false) @map("is_email_verified")
  isPhoneVerified         Boolean                  @default(false) @map("is_phone_verified")
  isSeller                Boolean                  @default(false) @map("is_seller")
  showTrustScore          Boolean                  @default(true) @map("show_trust_score")
  sellerType              SellerType?              @map("seller_type")
  taxId                   String?                  @map("tax_id")
  companyName             String?                  @unique @map("company_name")
  businessStatus          BusinessStatus?          @map("business_status")
  // Kurumsal başvuru detayları (register'da alınıyordu ama saklanmıyordu; admin
  // incelemesi + belge ekranı için kalıcılaştırıldı).
  companyType             String?                  @map("company_type")
  taxOffice               String?                  @map("tax_office")
  companyCity             String?                  @map("company_city")
  companyDistrict         String?                  @map("company_district")
  fcmToken                String?                  @map("fcm_token")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  birthDate               DateTime?                @map("birth_date")
  bannedAt                DateTime?                @map("banned_at")
  bannedBy                String?                  @map("banned_by")
  bannedReason            String?                  @map("banned_reason")
  isBanned                Boolean                  @default(false) @map("is_banned")
  acceptsMarketingEmails  Boolean                  @default(false) @map("accepts_marketing_emails")
  preferredLanguage       String?                  @map("preferred_language")
  homeTourVersion         Int                      @default(0) @map("home_tour_version")
  // İlan verme sayfası tanıtım turu — ana sayfa turundan bağımsız ilerler.
  listingTourVersion      Int                      @default(0) @map("listing_tour_version")
  notificationSettings    Json?                    @map("notification_settings")
  lastActivityAt          DateTime?                @map("last_activity_at")
  lastLoginAt             DateTime?                @map("last_login_at")
  deletedAt               DateTime?                @map("deleted_at")
  storeViewCount          Int                      @default(0) @map("store_view_count")
  addresses               Address[]
  adminUser               AdminUser?
  cart                    Cart?
  collectionLikes         CollectionLike[]
  collectionViews         CollectionView[]
  collections             Collection[]
  discountUsages          DiscountUsage[]
  couponReservations      CouponReservation[]
  discounts               Discount[]
  emailVerificationTokens EmailVerificationToken[]
  emailChangeTokens       EmailChangeToken[]
  phoneVerificationTokens PhoneVerificationToken[]
  buyerInvoices           Invoice[]                @relation("BuyerInvoices")
  sellerInvoices          Invoice[]                @relation("SellerInvoices")
  receivedMessages        Message[]                @relation("MessageReceiver")
  sentMessages            Message[]                @relation("MessageSender")
  buyerOffers             Offer[]                  @relation("BuyerOffers")
  sellerOffers            Offer[]                  @relation("SellerOffers")
  buyerOrders             Order[]                  @relation("BuyerOrders")
  sellerOrders            Order[]                  @relation("SellerOrders")
  buyerCheckoutGroups     CheckoutGroup[]          @relation("BuyerCheckoutGroups")
  passwordResetTokens     PasswordResetToken[]
  paymentHolds            PaymentHold[]
  productLikes            ProductLike[]
  productRatings          ProductRating[]
  products                Product[]                @relation("SellerProducts")
  pushTokens              PushToken[]
  givenRatings            Rating[]                 @relation("RatingGiver")
  receivedRatings         Rating[]                 @relation("RatingReceiver")
  refreshTokens           RefreshToken[]
  assignedTickets         SupportTicket[]          @relation("TicketAssignee")
  supportTickets          SupportTicket[]          @relation("TicketCreator")
  ticketMessages          TicketMessage[]
  initiatedTrades         Trade[]                  @relation("TradeInitiator")
  receivedTrades          Trade[]                  @relation("TradeReceiver")
  twoFactorSecret         TwoFactorSecret?
  following               UserFollow[]             @relation("Followers")
  followers               UserFollow[]             @relation("Following")
  membership              UserMembership?
  wishlist                Wishlist?
  bankAccount             SellerBankAccount?
  sellerDocuments         SellerDocument[]
  corporateApplication    CorporateApplication?
  targetedAdPackages      AdPackageUserTarget[]
  payoutTransfers         PayoutTransfer[]         @relation("SellerPayoutTransfers")
  refundRequests          RefundRequest[]          @relation("UserRefundRequests")
  savedCards              SavedCard[]
  oauthAccounts           OAuthAccount[]
  reports                 Report[]                 @relation("ReporterReports")
  productBoosts           ProductBoost[]

  @@index([email])
  @@index([adminCode])
  @@index([username])
  @@index([isSeller])
  @@map("users")
}

/// Kurumsal hesap, ön başvuru onaylanmadan User oluşturmaz. Başvuru onaylanınca
/// tek kullanımlık davet ile parola/kullanıcı adı belirlenir; kalan bilgiler ve
/// belgeler tamamlandıktan sonra kurumsal satıcı nihai olarak aktive edilir.
model CorporateApplication {
  id                    String                      @id @default(uuid())
  userId                String?                     @unique @map("user_id")
  status                CorporateApplicationStatus  @default(submitted)
  authorizedFullName    String                      @map("authorized_full_name")
  companyLegalName      String                      @map("company_legal_name")
  companyTitle          String                      @map("company_title")
  companyAddress        String                      @map("company_address")
  companyEmail          String                      @map("company_email")
  kepAddress            String?                     @map("kep_address")
  phone                 String
  contactPhone          String?                     @map("contact_phone")
  taxId                 String?                     @map("tax_id")
  companyType           String?                     @map("company_type")
  taxOffice             String?                     @map("tax_office")
  companyCity           String?                     @map("company_city")
  companyDistrict       String?                     @map("company_district")
  bankAccountHolder     String?                     @map("bank_account_holder")
  iban                  String?
  reviewNote            String?                     @map("review_note")
  invitationTokenHash   String?                     @unique @map("invitation_token_hash")
  invitationExpiresAt   DateTime?                   @map("invitation_expires_at")
  preliminaryApprovedAt DateTime?                   @map("preliminary_approved_at")
  activatedAt           DateTime?                   @map("activated_at")
  submittedForReviewAt  DateTime?                   @map("submitted_for_review_at")
  finalApprovedAt       DateTime?                   @map("final_approved_at")
  rejectedAt            DateTime?                   @map("rejected_at")
  createdAt             DateTime                    @default(now()) @map("created_at")
  updatedAt             DateTime                    @updatedAt @map("updated_at")
  user                  User?                       @relation(fields: [userId], references: [id], onDelete: SetNull)
  documents             SellerDocument[]
  stakeholders          CorporateStakeholder[]
  events                CorporateApplicationEvent[]

  @@index([status, createdAt(sort: Desc)])
  @@index([companyEmail])
  @@index([phone])
  @@index([taxId])
  @@map("corporate_applications")
}

model CorporateStakeholder {
  id             String                @id @default(uuid())
  applicationId  String                @map("application_id")
  fullName       String                @map("full_name")
  identityType   CorporateIdentityType @map("identity_type")
  identityNumber String?               @map("identity_number")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  application    CorporateApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  documents      SellerDocument[]

  @@index([applicationId])
  @@map("corporate_stakeholders")
}

model CorporateApplicationEvent {
  id            String               @id @default(uuid())
  applicationId String               @map("application_id")
  action        String
  note          String?
  actorAdminId  String?              @map("actor_admin_id")
  actorUserId   String?              @map("actor_user_id")
  metadata      Json?
  createdAt     DateTime             @default(now()) @map("created_at")
  application   CorporateApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt(sort: Desc)])
  @@map("corporate_application_events")
}

/// Kullanıcıların gönderdiği içerik şikayetleri (ürün/kullanıcı/koleksiyon/mesaj).
/// Hedef polimorfik olduğu için targetId düz string olarak tutulur (FK yok).
model Report {
  id          String    @id @default(uuid())
  reporterId  String    @map("reporter_id")
  type        String // product | user | collection | message
  targetId    String    @map("target_id")
  reason      String
  description String?
  status      String    @default("pending") // pending | under_review | resolved | dismissed
  adminNote   String?   @map("admin_note")
  resolvedAt  DateTime? @map("resolved_at")
  resolvedBy  String?   @map("resolved_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  reporter    User      @relation("ReporterReports", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([type])
  @@index([reporterId])
  @@index([createdAt])
  @@map("reports")
}

/// Anasayfa öne çıkarma bölümlerinin (haftanın koleksiyoneri / haftanın şirketi)
/// haftalık kazananını saklayan snapshot. Ağır skorlama her istekte değil, bir
/// cron job ile periyodik hesaplanır; endpoint'ler bu satırı okuyup kazananı
/// taze veriyle doldurur. `type` tek kayıt garantisi için primary key'dir.
model FeaturedSnapshot {
  type       String   @id // 'collector' | 'business'
  entityId   String   @map("entity_id") // kazanan koleksiyon / kullanıcı id'si
  score      Int      @default(0)
  computedAt DateTime @default(now()) @map("computed_at")

  @@map("featured_snapshots")
}

model OAuthAccount {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  provider       String
  providerUserId String   @map("provider_user_id")
  email          String?
  createdAt      DateTime @default(now()) @map("created_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_accounts")
}

model TwoFactorSecret {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  secret      String
  isEnabled   Boolean  @default(false) @map("is_enabled")
  backupCodes String[] @map("backup_codes")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor_secrets")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique
  email     String
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("email_verification_tokens")
}

model PhoneVerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  phone     String
  codeHash  String    @map("code_hash")
  expiresAt DateTime  @map("expires_at")
  attempts  Int       @default(0)
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("phone_verification_tokens")
}

/// Pending email-change requests. The new email lives ONLY here (never on the
/// user row) so the current email stays authoritative until the 6-digit code
/// is verified. Mirrors PhoneVerificationToken.
model EmailChangeToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  newEmail  String    @map("new_email")
  codeHash  String    @map("code_hash")
  expiresAt DateTime  @map("expires_at")
  attempts  Int       @default(0)
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_change_tokens")
}

model NewsletterSubscriber {
  id               String    @id @default(uuid())
  email            String    @unique
  newsletter       Boolean   @default(true) @map("newsletter")
  promotions       Boolean   @default(true) @map("promotions")
  unsubscribeToken String    @unique @map("unsubscribe_token")
  unsubscribedAt   DateTime? @map("unsubscribed_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([email])
  @@index([unsubscribeToken])
  @@index([unsubscribedAt])
  @@map("newsletter_subscribers")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  deviceInfo String?   @map("device_info")
  ipAddress  String?   @map("ip_address")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model AdminUser {
  id               String         @id @default(uuid())
  userId           String         @unique @map("user_id")
  role             AdminRole
  permissions      Json?
  isActive         Boolean        @default(true) @map("is_active")
  twoFactorEnabled Boolean        @default(false) @map("two_factor_enabled")
  lastLoginAt      DateTime?      @map("last_login_at")
  lastLoginIp      String?        @map("last_login_ip")
  createdAt        DateTime       @default(now()) @map("created_at")
  createdBy        String?        @map("created_by")
  adminSessions    AdminSession[]
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  auditLogs        AuditLog[]

  @@map("admin_users")
}

model AdminSession {
  id           String    @id @default(uuid())
  adminUserId  String    @map("admin_user_id")
  sessionToken String    @unique @map("session_token")
  ipAddress    String?   @map("ip_address")
  userAgent    String?   @map("user_agent")
  expiresAt    DateTime  @map("expires_at")
  lastActiveAt DateTime  @default(now()) @map("last_active_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  adminUser    AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([sessionToken])
  @@index([expiresAt])
  @@map("admin_sessions")
}

model Address {
  id             String          @id @default(uuid())
  userId         String          @map("user_id")
  title          String?
  fullName       String          @map("full_name")
  phone          String
  city           String
  district       String
  address        String
  zipCode        String?         @map("zip_code")
  isDefault      Boolean         @default(false) @map("is_default")
  createdAt      DateTime        @default(now()) @map("created_at")
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tradeShipments TradeShipment[]

  @@map("addresses")
}

model MembershipTier {
  id                   String              @id @default(uuid())
  type                 MembershipTierType  @unique
  name                 String
  description          String?
  monthlyPrice         Decimal             @map("monthly_price") @db.Decimal(10, 2)
  yearlyPrice          Decimal             @map("yearly_price") @db.Decimal(10, 2)
  maxFreeListings      Int                 @map("max_free_listings")
  maxTotalListings     Int                 @map("max_total_listings")
  maxImagesPerListing  Int                 @map("max_images_per_listing")
  canCreateCollections Boolean             @default(false) @map("can_create_collections")
  canTrade             Boolean             @default(false) @map("can_trade")
  isAdFree             Boolean             @default(false) @map("is_ad_free")
  featuredListingSlots Int                 @default(0) @map("featured_listing_slots")
  commissionDiscount   Decimal             @default(0) @map("commission_discount") @db.Decimal(5, 4)
  isActive             Boolean             @default(true) @map("is_active")
  sortOrder            Int                 @default(0) @map("sort_order")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  userMemberships      UserMembership[]
  membershipPayments   MembershipPayment[]

  @@map("membership_tiers")
}

model UserMembership {
  id                     String              @id @default(uuid())
  userId                 String              @unique @map("user_id")
  tierId                 String              @map("tier_id")
  status                 SubscriptionStatus  @default(active)
  currentPeriodStart     DateTime            @map("current_period_start")
  currentPeriodEnd       DateTime            @map("current_period_end")
  cancelledAt            DateTime?           @map("cancelled_at")
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")
  autoRenew              Boolean             @default(false) @map("auto_renew")
  // Ertelemeli downgrade: kullanıcı daha düşük bir tier'a geçmek istediğinde
  // (örn. premium→temel) tier HEMEN değişmez; mevcut ödenmiş dönem sonuna kadar
  // yüksek tier sürer, dönem sonunda bu tip'e geçilir. null = bekleyen downgrade yok.
  // Upgrade'ler anında uygulanır, bu alanı kullanmaz.
  scheduledTierType      MembershipTierType? @map("scheduled_tier_type")
  // Ertelemeli period değişimi: dönem sonunda geçilecek faturalama periyodu
  // ('monthly' | 'yearly'). Örn. yıllık→aylık downgrade'inde aylık olarak işlenir.
  // null = period değişimi planlı değil.
  scheduledBillingPeriod String?             @map("scheduled_billing_period")
  payments               MembershipPayment[]
  tier                   MembershipTier      @relation(fields: [tierId], references: [id])
  user                   User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("user_memberships")
}

model MembershipPayment {
  id                String          @id @default(uuid())
  membershipId      String          @map("membership_id")
  orderId           String?         @unique @map("order_id")
  targetTierId      String?         @map("target_tier_id")
  billingPeriod     String?         @map("billing_period")
  idempotencyKey    String?         @unique @map("idempotency_key")
  amount            Decimal         @db.Decimal(10, 2)
  provider          String
  providerPaymentId String?         @map("provider_payment_id")
  // Oto-yenileme (recurring) gözlemlenebilirliği: PayTR merchant_oid + ödeme yöntemi
  // + ham sağlayıcı yanıtı. Muhasebe/mutabakat/destek için (Faz 6.5 PSP reconciliation).
  merchantOid       String?         @map("merchant_oid")
  paymentType       String?         @map("payment_type") // card/eft
  metadata          Json?
  status            PaymentStatus   @default(pending)
  periodStart       DateTime        @map("period_start")
  periodEnd         DateTime        @map("period_end")
  createdAt         DateTime        @default(now()) @map("created_at")
  membership        UserMembership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  order             Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  targetTier        MembershipTier? @relation(fields: [targetTierId], references: [id], onDelete: SetNull)

  @@index([merchantOid])
  @@index([membershipId, status])
  @@index([targetTierId])
  @@map("membership_payments")
}

model Category {
  id              String           @id @default(uuid())
  name            String           @unique
  slug            String           @unique
  description     String?
  parentId        String?          @map("parent_id")
  sortOrder       Int              @default(0) @map("sort_order")
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at")
  parent          Category?        @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children        Category[]       @relation("CategoryHierarchy")
  commissionRules CommissionRule[]
  discounts       Discount[]
  products        Product[]
  taxRules        TaxRule[]
  collections     Collection[]

  @@map("categories")
}

model Brand {
  id          String     @id @default(uuid())
  name        String     @unique
  slug        String     @unique
  logo        String?
  description String?
  website     String?
  sortOrder   Int        @default(0) @map("sort_order")
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  country     String?
  foundedYear Int?       @map("founded_year")
  carModels   CarModel[]
  products    Product[]

  @@index([isActive])
  @@index([sortOrder])
  @@map("brands")
}

model CarModel {
  id          String    @id @default(uuid())
  brandId     String    @map("brand_id")
  name        String
  slug        String    @unique
  image       String?
  description String?
  yearStart   Int?      @map("year_start")
  yearEnd     Int?      @map("year_end")
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  brand       Brand     @relation(fields: [brandId], references: [id])
  products    Product[]

  @@index([brandId])
  @@index([isActive])
  @@index([sortOrder])
  @@map("car_models")
}

model Manufacturer {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  logo        String?
  description String?
  website     String?
  country     String?
  foundedYear Int?      @map("founded_year")
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  products    Product[]

  @@index([isActive])
  @@index([sortOrder])
  @@map("manufacturers")
}

model Product {
  id                  String             @id @default(uuid())
  /// İnsan-okunur ilan numarası: "U" + 6 hane sıra no (U010001). Kalıcı,
  /// kullanıcıya gösterilir (ilan detayı, şikayet formu, destek). Postgres
  /// tarafında generate_product_code() ile üretilir; uygulama yazmaz.
  productCode         String             @unique @default(dbgenerated("generate_product_code()")) @map("product_code")
  sellerId            String             @map("seller_id")
  categoryId          String             @map("category_id")
  title               String
  description         String?
  price               Decimal            @db.Decimal(10, 2)
  condition           ProductCondition
  status              ProductStatus      @default(pending)
  isTradeEnabled      Boolean            @default(false) @map("is_trade_enabled")
  viewCount           Int                @default(0) @map("view_count")
  clickCount          Int                @default(0) @map("click_count")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  version             Int                @default(1)
  likeCount           Int                @default(0) @map("like_count")
  maxQuantityPerOrder Int?               @map("max_quantity_per_order")
  popularityScore     Int?               @map("popularity_score")
  popularityUpdatedAt DateTime?          @map("popularity_updated_at")
  quantity            Int?               @map("quantity")
  reservedQuantity    Int?               @default(0) @map("reserved_quantity")
  // Satıcının seçtiği paket boyutu — ilan formundaki TEK kargo girdisi.
  shippingPackageTier ShippingPackageTierCode @default(small) @map("shipping_package_tier")
  // Kademeden TÜRETİLİR (kademenin üst sınırı): admin görür, paket desisi
  // toplanırken (Σ desi × adet) bu değer kullanılır. Satıcı doğrudan girmez.
  shippingDesi        Int                @default(1) @map("shipping_desi")
  slug                String?            @unique
  oldPrice            Decimal?           @map("old_price") @db.Decimal(10, 2)
  originalPrice       Decimal?           @map("original_price") @db.Decimal(10, 2)
  saleEndDate         DateTime?          @map("sale_end_date")
  salePrice           Decimal?           @map("sale_price") @db.Decimal(10, 2)
  saleStartDate       DateTime?          @map("sale_start_date")
  brandId             String?            @map("brand_id")
  bundleSize          Int?               @map("bundle_size")
  editionNumber       String?            @map("edition_number")
  editionTotal        Int?               @map("edition_total")
  isLimited           Boolean            @default(false) @map("is_limited")
  isPreorder          Boolean            @default(false) @map("is_preorder")
  isSet               Boolean            @default(false) @map("is_set")
  releaseDate         DateTime?          @map("release_date")
  carModelId          String?            @map("car_model_id")
  manufacturerId      String?            @map("manufacturer_id")
  modelCode           String?            @map("model_code")
  color               String?
  isBoxed             Boolean?           @map("is_boxed")
  averageRating       Decimal?           @map("average_rating") @db.Decimal(3, 2)
  ratingCount         Int                @default(0) @map("rating_count")
  boostedUntil        DateTime?          @map("boosted_until")
  /// Timestamp of the current active boost purchase — drives LIFO ordering
  /// (most-recently-boosted first) in search/category and the home showcase.
  boostedAt           DateTime?          @map("boosted_at")
  /// Active only while a `showcaseOnHome` (Vitrin) package is running; the home
  /// showcase area queries `homeShowcaseUntil > now` ordered by `boostedAt` desc.
  homeShowcaseUntil   DateTime?          @map("home_showcase_until")
  qualityScore        Int                @default(0) @map("quality_score")
  rankTier            Int                @default(0) @map("rank_tier")
  relevanceScore      Int?               @map("relevance_score")
  /// AI görsel moderasyonu (services/ai-moderation). null = henüz denetlenmedi.
  aiCheckStatus       String?            @map("ai_check_status")
  aiRelevanceScore    Float?             @map("ai_relevance_score")
  aiNsfwScore         Float?             @map("ai_nsfw_score")
  aiCheckLabels       Json?              @map("ai_check_labels")
  aiCheckReason       String?            @map("ai_check_reason")
  aiCheckedAt         DateTime?          @map("ai_checked_at")
  /// Denormalized concat of title + description + model code + color + attribute display values.
  /// Maintained by Postgres triggers; never write directly from application code.
  /// Used for full-text search via the GIN index `products_search_text_fts_idx`.
  searchText          String?            @map("search_text")
  cartItems           CartItem[]
  collectionItems     CollectionItem[]
  offers              Offer[]
  orders              Order[]
  productAttributes   ProductAttribute[]
  images              ProductImage[]
  likes               ProductLike[]
  productRatings      ProductRating[]
  boosts              ProductBoost[]
  brand               Brand?             @relation(fields: [brandId], references: [id])
  carModel            CarModel?          @relation(fields: [carModelId], references: [id])
  category            Category           @relation(fields: [categoryId], references: [id])
  manufacturer        Manufacturer?      @relation(fields: [manufacturerId], references: [id])
  seller              User               @relation("SellerProducts", fields: [sellerId], references: [id])
  tradeItemsOffered   TradeItem[]        @relation("TradeItemProduct")
  wishlistItems       WishlistItem[]

  @@index([sellerId])
  @@index([brandId])
  @@index([carModelId])
  @@index([manufacturerId])
  @@index([status])
  @@index([isTradeEnabled])
  @@index([isPreorder])
  @@index([isLimited])
  @@index([isSet])
  @@index([createdAt(sort: Desc)])
  @@index([saleStartDate, saleEndDate])
  @@index([averageRating(sort: Desc), ratingCount(sort: Desc)])
  @@index([rankTier(sort: Desc), qualityScore(sort: Desc), createdAt(sort: Desc)])
  @@index([boostedUntil])
  @@index([boostedUntil, boostedAt(sort: Desc)])
  @@index([homeShowcaseUntil, boostedAt(sort: Desc)])
  @@index([relevanceScore(sort: Desc)])
  @@map("products")
}

model ProductBoost {
  id                     String      @id @default(uuid())
  productId              String      @map("product_id")
  userId                 String      @map("user_id")
  /// Purchased ad package. Nullable for legacy boosts predating the package model.
  packageId              String?     @map("package_id")
  /// Snapshot of the package name at purchase time (survives later package edits).
  packageName            String?     @map("package_name")
  /// Snapshot of the package's `showcaseOnHome` flag — the home-showcase query
  /// keys on the product column set from this, so a later package flip is inert.
  showcaseOnHome         Boolean     @default(false) @map("showcase_on_home")
  durationDays           Int         @map("duration_days")
  price                  Decimal     @db.Decimal(10, 2)
  status                 BoostStatus @default(pending)
  autoRenew              Boolean     @default(false) @map("auto_renew")
  startsAt               DateTime?   @map("starts_at")
  endsAt                 DateTime?   @map("ends_at")
  /// Set on activation — the LIFO ordering key for search + home showcase.
  purchasedAt            DateTime?   @map("purchased_at")
  pausedAt               DateTime?   @map("paused_at")
  pausedRemainingSeconds Int?        @map("paused_remaining_seconds")
  extendedDays           Int         @default(0) @map("extended_days")
  baselineViewCount      Int?        @map("baseline_view_count")
  baselineLikeCount      Int?        @map("baseline_like_count")
  baselineClickCount     Int?        @map("baseline_click_count")
  finalViewCount         Int?        @map("final_view_count")
  finalLikeCount         Int?        @map("final_like_count")
  finalClickCount        Int?        @map("final_click_count")
  orderId                String?     @unique @map("order_id")
  createdAt              DateTime    @default(now()) @map("created_at")
  updatedAt              DateTime    @updatedAt @map("updated_at")
  product                Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  user                   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  package                AdPackage?  @relation(fields: [packageId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([userId])
  @@index([status, endsAt])
  @@index([packageId])
  @@map("product_boosts")
}

/// Admin-managed advertisement/boost package (e.g. "Ekonomik", "Vitrin"). Fully
/// dynamic — admins add packages and price tiers; `showcaseOnHome` marks the ones
/// that also appear in the homepage showcase area (Vitrin), on top of the search
/// priority every active package grants.
model AdPackage {
  id             String                    @id @default(uuid())
  name           String
  slug           String                    @unique
  showcaseOnHome Boolean                   @default(false) @map("showcase_on_home")
  isActive       Boolean                   @default(true) @map("is_active")
  sortOrder      Int                       @default(0) @map("sort_order")
  audienceMode   AdPackageAudienceMode     @default(everyone) @map("audience_mode")
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")
  tiers          AdPackageTier[]
  boosts         ProductBoost[]
  targetTiers    AdPackageMembershipTier[]
  targetUsers    AdPackageUserTarget[]

  @@map("ad_packages")
}

model AdPackageMembershipTier {
  packageId String             @map("package_id")
  tierType  MembershipTierType @map("tier_type")
  package   AdPackage          @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@id([packageId, tierType])
  @@index([tierType])
  @@map("ad_package_membership_tiers")
}

model AdPackageUserTarget {
  packageId String    @map("package_id")
  userId    String    @map("user_id")
  createdAt DateTime  @default(now()) @map("created_at")
  package   AdPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([packageId, userId])
  @@index([userId])
  @@map("ad_package_user_targets")
}

/// One priced cell of a package's matrix: a duration + a product-price range →
/// price (+ optional, possibly time-bounded, campaign price). Rows are added/
/// removed freely by admins ("satır ekle/çıkar").
model AdPackageTier {
  id               String    @id @default(uuid())
  packageId        String    @map("package_id")
  durationDays     Int       @map("duration_days")
  /// Product-price range this tier applies to. `maxAmount` null = no upper bound.
  minAmount        Decimal   @map("min_amount") @db.Decimal(12, 2)
  maxAmount        Decimal?  @map("max_amount") @db.Decimal(12, 2)
  price            Decimal   @db.Decimal(10, 2)
  campaignPrice    Decimal?  @map("campaign_price") @db.Decimal(10, 2)
  campaignStartsAt DateTime? @map("campaign_starts_at")
  campaignEndsAt   DateTime? @map("campaign_ends_at")
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  package          AdPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId, durationDays])
  @@map("ad_package_tiers")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  cardKey   String   @map("card_key")
  detailKey String   @map("detail_key")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model ProductLike {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
  @@map("product_likes")
}

model Trade {
  id                        String            @id @default(uuid())
  tradeNumber               String            @unique @map("trade_number")
  initiatorId               String            @map("initiator_id")
  receiverId                String            @map("receiver_id")
  status                    TradeStatus       @default(pending)
  cashAmount                Decimal?          @map("cash_amount") @db.Decimal(10, 2)
  cashPayerId               String?           @map("cash_payer_id")
  // LEGACY (v1): farkın yüzdesi olarak alınan aracılık komisyonu. v2'de komisyon
  // yoktur; iki taraf da sabit hizmet bedeli + kargo öder.
  cashCommission            Decimal?          @map("cash_commission") @db.Decimal(10, 2)
  // Fiyatlama sürümü — takas KABUL edildiğinde hangi modelin uygulandığını
  // sabitler. `v1`: tek taraflı komisyonlu fark ödemesi (mevcut takaslar).
  // `v2`: iki taraflı sabit hizmet bedeli + 2× kargo. Devam eden takaslar
  // açıldıkları modelle biter; ekranlar ve iade yolları bu alana bakar.
  pricingVersion            String            @default("v1") @map("pricing_version")
  initiatorMessage          String?           @map("initiator_message")
  receiverMessage           String?           @map("receiver_message")
  // Tarafların TAKAS için seçtiği teslimat adresi. Depo→kullanıcı (çıkış)
  // ayağında ve gönderici etiketinde kullanılır. Null ise kullanıcının
  // varsayılan adresine düşülür (geriye dönük uyum).
  initiatorAddressId        String?           @map("initiator_address_id")
  receiverAddressId         String?           @map("receiver_address_id")
  responseDeadline          DateTime          @map("response_deadline")
  paymentDeadline           DateTime?         @map("payment_deadline")
  shippingDeadline          DateTime?         @map("shipping_deadline")
  confirmationDeadline      DateTime?         @map("confirmation_deadline")
  acceptedAt                DateTime?         @map("accepted_at")
  completedAt               DateTime?         @map("completed_at")
  cancelledAt               DateTime?         @map("cancelled_at")
  cancelReason              String?           @map("cancel_reason")
  // Stamped when the first to_warehouse shipment is delivered. Once non-null,
  // user-side cancel is locked: only admin reject/force-cancel can resolve.
  firstWarehouseArrivalAt   DateTime?         @map("first_warehouse_arrival_at")
  cancelLockedAt            DateTime?         @map("cancel_locked_at")
  // Populated when an admin reject's PayTR refund fails. Surfaced in admin UI
  // so the operator can retry the refund.
  refundFailureReason       String?           @map("refund_failure_reason")
  refundFailureAt           DateTime?         @map("refund_failure_at")
  // Flag set when an admin marks a return shipment lost and the affected user
  // is owed manual compensation. Cleared by admin after settling out of band.
  compensationPendingUserId String?           @map("compensation_pending_user_id")
  compensationResolvedAt    DateTime?         @map("compensation_resolved_at")
  createdAt                 DateTime          @default(now()) @map("created_at")
  updatedAt                 DateTime          @updatedAt @map("updated_at")
  version                   Int               @default(1)
  /// v1'de en fazla BİR satır (yalnız farkı ödeyen taraf); v2'de taraf başına
  /// bir satır. Depo süreci ancak TÜM satırlar `completed` olunca başlar.
  cashPayments              TradeCashPayment[]
  dispute                   TradeDispute?
  items                     TradeItem[]       @relation("TradeItems")
  messages                  TradeMessage[]
  shipments                 TradeShipment[]
  refundAttempts            RefundAttempt[]
  initiator                 User              @relation("TradeInitiator", fields: [initiatorId], references: [id])
  receiver                  User              @relation("TradeReceiver", fields: [receiverId], references: [id])

  @@index([initiatorId])
  @@index([receiverId])
  @@index([status])
  @@index([responseDeadline])
  @@map("trades")
}

model TradeItem {
  id           String   @id @default(uuid())
  tradeId      String   @map("trade_id")
  productId    String   @map("product_id")
  side         String
  quantity     Int      @default(1)
  valueAtTrade Decimal  @map("value_at_trade") @db.Decimal(10, 2)
  createdAt    DateTime @default(now()) @map("created_at")
  trade        Trade    @relation("TradeItems", fields: [tradeId], references: [id], onDelete: Cascade, map: "trade_initiator_items_fk")
  product      Product  @relation("TradeItemProduct", fields: [productId], references: [id])

  @@index([tradeId])
  @@index([productId])
  @@map("trade_items")
}

model TradeShipment {
  id                 String               @id @default(uuid())
  tradeId            String               @map("trade_id")
  shipperId          String               @map("shipper_id")
  // Nullable: kabulde depo etiketi otomatik oluşur (adres henüz yok), kullanıcı kargoya verirken set edilir
  fromAddressId      String?              @map("from_address_id")
  carrier            String
  // trackingNumber = OzelKargoTakipNo (bizim ref; poller bununla sorgular).
  trackingNumber     String?              @map("tracking_number")
  // Gerçek Sürat kargo kodu (KargoTakipNo) + ZPL etiket (OrtakBarkodOlustur ile
  // takas onaylanınca anında oluşur; UI'da providerTrackingId gösterilir).
  providerTrackingId String?              @map("provider_tracking_id")
  labelZpl           String?              @map("label_zpl")
  status             ShipmentStatus       @default(pending)
  shippedAt          DateTime?            @map("shipped_at")
  deliveredAt        DateTime?            @map("delivered_at")
  confirmedAt        DateTime?            @map("confirmed_at")
  // Admin-set when a shipment is declared lost (typically a return leg that
  // never arrived). Drives compensation flow on the parent trade.
  lostAt             DateTime?            @map("lost_at")
  lostReason         String?              @map("lost_reason")
  // Escrow: which leg of the journey this shipment represents
  leg                String               @default("to_warehouse")
  // Recipient of this shipment: null = warehouse, else initiator or receiver user id
  recipientUserId    String?              @map("recipient_user_id")
  recipientType      String               @default("warehouse") @map("recipient_type")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  events             TradeShipmentEvent[]
  fromAddress        Address?             @relation(fields: [fromAddressId], references: [id])
  trade              Trade                @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@index([tradeId])
  @@index([leg])
  @@map("trade_shipments")
}

model TradeShipmentEvent {
  id              String        @id @default(uuid())
  tradeShipmentId String        @map("trade_shipment_id")
  status          String
  description     String?
  location        String?
  eventTime       DateTime      @map("event_time")
  createdAt       DateTime      @default(now()) @map("created_at")
  tradeShipment   TradeShipment @relation(fields: [tradeShipmentId], references: [id], onDelete: Cascade)

  @@map("trade_shipment_events")
}

/// Takas ödemesi. v1: takas başına EN FAZLA BİR satır (yalnız farkı ödeyen
/// taraf). v2'de HER İKİ taraf ödeyecek → takas başına iki satır olacak ve depo
/// süreci ancak ikisi de `completed` olunca başlayacak (PR2).
model TradeCashPayment {
  id                String           @id @default(uuid())
  tradeId           String           @map("trade_id")
  payerId           String           @map("payer_id")
  /// Farkın gideceği taraf — yalnız fark taşıyan satırda dolu. Hizmet bedeli ve
  /// kargo platformda kalır, alıcısı yoktur.
  recipientId       String?          @map("recipient_id")
  /// Nakit fark (v2'de yalnız fark ödeyen tarafın satırında > 0).
  amount            Decimal          @db.Decimal(10, 2)
  /// v2: takas hizmet bedeli — kural sabitlerinin toplamı (KDV DAHİL).
  tradeFeeAmount    Decimal          @default(0) @map("trade_fee_amount") @db.Decimal(10, 2)
  /// v2: bu tarafın 2 bacaklık kargo bedeli. İPTALDE İADE EDİLMEZ (ürün kargoya
  /// verildikten sonra); kargoya verilmeden önceki iptalde tam iade edilir.
  shippingAmount    Decimal          @default(0) @map("shipping_amount") @db.Decimal(10, 2)
  /// LEGACY (v1): aracılık komisyonu — KDV HARİÇ matrah. v2'de 0'dır.
  commission        Decimal          @default(0) @db.Decimal(10, 2)
  /// LEGACY (v1): komisyonun KDV'si. v2'de 0 (ücretler KDV dahil sabittir).
  commissionTaxAmount Decimal        @default(0) @map("commission_tax_amount") @db.Decimal(10, 2)
  totalAmount       Decimal          @map("total_amount") @db.Decimal(10, 2)
  provider          String
  providerPaymentId String?          @map("provider_payment_id")
  status            PaymentStatus    @default(pending)
  paidAt            DateTime?        @map("paid_at")
  // Escrow hold: set when trade completes; released when holdReleaseAt passes
  holdReleaseAt     DateTime?        @map("hold_release_at")
  releasedAt        DateTime?        @map("released_at")
  refundedAt        DateTime?        @map("refunded_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  trade             Trade            @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  payment           Payment?
  payoutTransfers   PayoutTransfer[] @relation("TradeCashPayoutTransfers")

  /// Taraf başına TEK ödeme satırı (v2'de aynı takasta iki taraf, iki satır).
  @@unique([tradeId, payerId])
  @@index([tradeId])
  @@map("trade_cash_payments")
}

model TradeDispute {
  id              String    @id @default(uuid())
  tradeId         String    @unique @map("trade_id")
  raisedById      String    @map("raised_by_id")
  reason          String
  description     String
  evidence        Json?
  resolution      String?
  resolvedById    String?   @map("resolved_by_id")
  resolvedAt      DateTime? @map("resolved_at")
  resolutionNotes String?   @map("resolution_notes")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  trade           Trade     @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@map("trade_disputes")
}

model TradeMessage {
  id        String   @id @default(uuid())
  tradeId   String   @map("trade_id")
  senderId  String   @map("sender_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  trade     Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@index([tradeId])
  @@map("trade_messages")
}

model MessageThread {
  id             String    @id @default(uuid())
  participant1Id String    @map("participant1_id")
  participant2Id String    @map("participant2_id")
  // One thread per participant pair. `productId` is the most-recently discussed
  // product (for list/header context) — product context per message lives on
  // Message.productId, not in the thread key.
  productId      String?   @map("product_id")
  lastMessageAt  DateTime  @default(now()) @map("last_message_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  messages       Message[]

  @@unique([participant1Id, participant2Id])
  @@index([participant1Id])
  @@index([participant2Id])
  @@map("message_threads")
}

model Message {
  id              String        @id @default(uuid())
  threadId        String        @map("thread_id")
  senderId        String        @map("sender_id")
  receiverId      String        @map("receiver_id")
  // Optional product this message is about (per-message context). Set when the
  // buyer opens the chat from a listing; also updates the thread's latest product.
  productId       String?       @map("product_id")
  content         String
  filteredContent String?       @map("filtered_content")
  status          MessageStatus @default(sent)
  flaggedReason   String?       @map("flagged_reason")
  reviewedById    String?       @map("reviewed_by_id")
  reviewedAt      DateTime?     @map("reviewed_at")
  readAt          DateTime?     @map("read_at")
  deletedAt       DateTime?     @map("deleted_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  receiver        User          @relation("MessageReceiver", fields: [receiverId], references: [id])
  sender          User          @relation("MessageSender", fields: [senderId], references: [id])
  thread          MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([senderId])
  @@index([receiverId])
  @@index([productId])
  @@index([status])
  @@map("messages")
}

model ContentFilter {
  id               String   @id @default(uuid())
  filterType       String   @map("filter_type")
  name             String
  pattern          String
  replacement      String   @default("[içerik gizlendi]")
  requiresApproval Boolean  @default(true) @map("requires_approval")
  priority         Int      @default(0)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("content_filters")
}

model Rating {
  id         String       @id @default(uuid())
  giverId    String       @map("giver_id")
  receiverId String       @map("receiver_id")
  orderId    String?      @map("order_id")
  tradeId    String?      @map("trade_id")
  score      Int
  comment    String?
  status     RatingStatus @default(pending)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  giver      User         @relation("RatingGiver", fields: [giverId], references: [id])
  receiver   User         @relation("RatingReceiver", fields: [receiverId], references: [id])

  @@unique([giverId, orderId])
  @@unique([giverId, tradeId])
  @@index([receiverId])
  @@index([status])
  @@map("ratings")
}

model ProductRating {
  id                 String       @id @default(uuid())
  productId          String       @map("product_id")
  userId             String       @map("user_id")
  orderId            String       @unique @map("order_id")
  score              Int
  title              String?
  review             String?
  images             String[]
  isVerifiedPurchase Boolean      @default(true) @map("is_verified_purchase")
  helpfulCount       Int          @default(0) @map("helpful_count")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
