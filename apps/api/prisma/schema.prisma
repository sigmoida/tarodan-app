// Satıcı-paketi ("çatı"): bir sepet (CheckoutGroup) içinde AYNI satıcının siparişleri
// tek pakette birleşir. Kargo ücreti + (Faz 2'de) fiziksel Sürat gönderisi paket
// başınadır → 2 farklı satıcı = 2 paket = 2 kargo (ürün sayısından bağımsız). Direct-buy
// tek üründe de tek order'lı bir paket kullanılabilir (tek biçim). sellerId/buyerId düz
// kolon (User ilişkisi yok — denormalize, sorgu için yeterli).
model OrderPackage {
  id                      String         @id @default(uuid())
  // Koli numarası (PKG-…): paketin KALICI dış referansı. Sürat'a OzelKargoTakipNo
  // olarak bu gönderilir, müşteri kargosunu bununla sorgular. Eskiden paketin en
  // küçük orderNumber'ı TÜRETİLİYORDU; türetilmiş referans paketin sipariş kümesi
  // değişince kayıyor ve idempotency cache'i ıskalayıp MÜKERRER gönderi açıyordu.
  packageNumber           String         @unique @map("package_number")
  checkoutGroupId         String?        @map("checkout_group_id")
  sellerId                String         @map("seller_id")
  buyerId                 String         @map("buyer_id")
  // Bu satıcı paketi için TEK kargo ücreti (satıcının paket-içi satır toplamı bedava
  // eşiğini geçerse 0). KANONİK olarak ALICI payıdır (buyerShippingAmount) — tüm
  // checkout yolları (direct/group/guest) artık aynı semantiği yazar.
  shippingCost            Decimal        @default(0) @map("shipping_cost") @db.Decimal(10, 2)
  // Kargo tarife snapshot'ı: sipariş anındaki aktif tarife. Yeni checkout akışları
  // aktif tarife yoksa fail-closed davranır; nullable alanlar yalnız eski kayıtlar içindir.
  // Geçmişe dönük tarife değişiminden bağımsız audit/yeniden-hesap ve 409 kontrolü için.
  shippingTariffId        String?        @map("shipping_tariff_id")
  shippingTariffVersion   Int?           @map("shipping_tariff_version")
  // Tam paket kargosu (alıcı/satıcı payına bölünmeden önce) + taraf payları + indirim.
  fullShippingAmount      Decimal        @default(0) @map("full_shipping_amount") @db.Decimal(10, 2)
  buyerShippingAmount     Decimal        @default(0) @map("buyer_shipping_amount") @db.Decimal(10, 2)
  sellerShippingAmount    Decimal        @default(0) @map("seller_shipping_amount") @db.Decimal(10, 2)
  shippingDiscountAmount  Decimal        @default(0) @map("shipping_discount_amount") @db.Decimal(10, 2)
  billableDesi            Int            @default(1) @map("billable_desi")
  shippingPricingSnapshot Json?          @map("shipping_pricing_snapshot")
  createdAt               DateTime       @default(now()) @map("created_at")
  updatedAt               DateTime       @updatedAt @map("updated_at")
  checkoutGroup           CheckoutGroup? @relation(fields: [checkoutGroupId], references: [id])
  orders                  Order[]
  shipments               Shipment[]

  @@index([checkoutGroupId])
  @@index([sellerId])
  @@map("order_packages")
}

model Order {
  id                         String                   @id @default(uuid())
  orderNumber                String                   @unique @map("order_number")
  buyerId                    String                   @map("buyer_id")
  sellerId                   String                   @map("seller_id")
  productId                  String                   @map("product_id")
  offerId                    String?                  @unique @map("offer_id")
  checkoutGroupId            String?                  @map("checkout_group_id")
  // Satıcı-paketi (çatı): aynı sepet+satıcı order'ları burada birleşir. Nullable —
  // Faz 1'de grup/direct checkout doldurur; eski/diğer yollar null kalabilir.
  packageId                  String?                  @map("package_id")
  shippingAddressId          String?                  @map("shipping_address_id")
  // Adet (sepet çoklu-adet): çoğu ikinci-el ürün tekildir → default 1. unitPrice
  // birim fiyatı; subtotal = unitPrice * quantity. Adet bazlı kısmi iade buna dayanır.
  quantity                   Int                      @default(1)
  unitPrice                  Decimal?                 @map("unit_price") @db.Decimal(10, 2)
  totalAmount                Decimal                  @map("total_amount") @db.Decimal(10, 2)
  shippingCost               Decimal                  @default(0) @map("shipping_cost") @db.Decimal(10, 2)
  commissionAmount           Decimal                  @map("commission_amount") @db.Decimal(10, 2)
  status                     OrderStatus              @default(pending_payment)
  shippingAddress            Json?                    @map("shipping_address")
  createdAt                  DateTime                 @default(now()) @map("created_at")
  updatedAt                  DateTime                 @updatedAt @map("updated_at")
  version                    Int                      @default(1)
  buyerFeeAmount             Decimal                  @default(0) @map("buyer_fee_amount") @db.Decimal(10, 2)
  sellerFeeAmount            Decimal                  @default(0) @map("seller_fee_amount") @db.Decimal(10, 2)
  // v2 kesinti kırılımı (CommissionRule v2). buyerFeeAmount = buyerCommission + buyerServiceFee,
  // sellerFeeAmount = sellerCommission + sellerPlatformFee (geriye-uyum için toplamlar korunur).
  buyerCommissionAmount      Decimal                  @default(0) @map("buyer_commission_amount") @db.Decimal(10, 2)
  buyerServiceFeeAmount      Decimal                  @default(0) @map("buyer_service_fee_amount") @db.Decimal(10, 2)
  sellerCommissionAmount     Decimal                  @default(0) @map("seller_commission_amount") @db.Decimal(10, 2)
  sellerPlatformFeeAmount    Decimal                  @default(0) @map("seller_platform_fee_amount") @db.Decimal(10, 2)
  // Kargo tutarının taraflara dağılımı. shippingCost geriye uyumlu alıcı payıdır;
  // tam paket bedeli OrderPackage.fullShippingAmount snapshot'ında tutulur.
  buyerShippingAmount        Decimal                  @default(0) @map("buyer_shipping_amount") @db.Decimal(10, 2)
  sellerShippingAmount       Decimal                  @default(0) @map("seller_shipping_amount") @db.Decimal(10, 2)
  discountAmount             Decimal                  @default(0) @map("discount_amount") @db.Decimal(10, 2)
  discountBreakdown          Json?                    @map("discount_breakdown")
  discountCode               String?                  @map("discount_code")
  // Bu siparişteki kupon indiriminin PLATFORM tarafından finanse edilen kısmı (F2.4).
  // Satıcı payout tabanı bu kadar geri EKLENİR (escrow) → platform-fonlu kampanyada
  // satıcı indirim öncesi tutar üzerinden ödenir. Varsayılan 0 (satıcı-fonlu, eski davranış).
  platformFundedDiscount     Decimal                  @default(0) @map("platform_funded_discount") @db.Decimal(10, 2)
  subtotal                   Decimal?                 @db.Decimal(10, 2)
  // ÜRÜN bedelinin KDV'si. `product_vat_enabled` ayarıyla yönetilir; varsayılan
  // KAPALI olduğu için yeni siparişlerde 0'dır (vitrin fiyatı KDV dahil sayılır,
  // beyanı satıcı yapar). Ayar açılırsa TaxRule/TaxRate altyapısı devreye girer.
  taxAmount                  Decimal                  @default(0) @map("tax_amount") @db.Decimal(10, 2)
  // HİZMET bedellerinin KDV'si — "hizmeti kim aldıysa KDV'sini o öder".
  // Alıcı tarafı (alıcı komisyonu + koruma hizmeti + alıcı kargo payı) alıcının
  // ödediğine EKLENİR; satıcı tarafı (satıcı komisyonu + platform hizmet bedeli +
  // satıcı kargo payı) satıcı payout'undan KESİLİR. Matrahlar yukarıdaki kolonlarda
  // durduğu için kalem bazında KDV saklanmaz — iki taraf toplamı yeterlidir.
  buyerServiceTaxAmount      Decimal                  @default(0) @map("buyer_service_tax_amount") @db.Decimal(10, 2)
  sellerServiceTaxAmount     Decimal                  @default(0) @map("seller_service_tax_amount") @db.Decimal(10, 2)
  // Tahsil anındaki hizmet KDV oranı (%). Toplamlar yukarıda duruyor ama ekranlar
  // "komisyon KDV'si / kargo KDV'si / hizmet bedeli KDV'si" kırılımını gösterebilsin
  // diye oran da snapshot'lanır: ayar sonradan değişse bile eski sipariş, tahsil
  // edildiği oranla görüntülenir.
  serviceVatRate             Decimal                  @default(0) @map("service_vat_rate") @db.Decimal(5, 2)
  // E-ticaret stopajı (GVK 94/19, varsayılan %1): yalnız vergi mükellefi (kurumsal onaylı)
  // satıcıda, KDV hariç ürün bedeli üzerinden. Satıcı payout'undan kesilir; alıcı tutarını etkilemez.
  withholdingTaxAmount       Decimal                  @default(0) @map("withholding_tax_amount") @db.Decimal(10, 2)
  // Checkout anındaki fiyat, vergi, komisyon, üyelik, indirim ve kargo kararları.
  // Sonradan değişen kurallar geçmiş siparişin finansal sonucunu değiştirmemelidir.
  financialSnapshot          Json?                    @map("financial_snapshot")
  cancelReason               String?                  @map("cancel_reason")
  cancellationReasonCode     OrderCancellationReason? @map("cancellation_reason_code")
  cancellationPolicySnapshot Json?                    @map("cancellation_policy_snapshot")
  cancellationType           OrderCancellationType?   @map("cancellation_type")
  preparingDeadline          DateTime?                @map("preparing_deadline")
  preparingWarningSentAt     DateTime?                @map("preparing_warning_sent_at")
  reservationReleasedAt      DateTime?                @map("reservation_released_at")
  stockRestoredAt            DateTime?                @map("stock_restored_at")
  paymentExpiresAt           DateTime                 @map("payment_expires_at")
  deliveredAt                DateTime?                @map("delivered_at")
  confirmationDeadline       DateTime?                @map("confirmation_deadline")
  buyerConfirmedAt           DateTime?                @map("buyer_confirmed_at")
  buyerConfirmationType      BuyerConfirmationType?   @map("buyer_confirmation_type")
  completedAt                DateTime?                @map("completed_at")
  // Teslim gelir faturaları (komisyon / hizmet bedeli / platform satışı) kesildi mi?
  // AÇIK işaret: eskiden backfill cron'u her turda TÜM delivered+completed siparişleri
  // (take:500, sırasız) tarıyordu; tamamlanan siparişler aday kümesinden hiç çıkmadığı
  // için 500 sipariş sonrası yeni teslimatlar pencereye giremeyip faturasız kalabiliyordu.
  revenueInvoicedAt          DateTime?                @map("revenue_invoiced_at")
  invoice                    Invoice?
  buyer                      User                     @relation("BuyerOrders", fields: [buyerId], references: [id])
  offer                      Offer?                   @relation(fields: [offerId], references: [id])
  product                    Product                  @relation(fields: [productId], references: [id])
  seller                     User                     @relation("SellerOrders", fields: [sellerId], references: [id])
  payment                    Payment?
  shipment                   Shipment?
  refundRequests             RefundRequest[]
  refundAttempts             RefundAttempt[]
  commissionLedger           CommissionLedger?
  sellerUploadedInvoice      SellerUploadedInvoice?
  membershipPayment          MembershipPayment?
  checkoutGroup              CheckoutGroup?           @relation(fields: [checkoutGroupId], references: [id])
  package                    OrderPackage?            @relation(fields: [packageId], references: [id])
  couponReservation          CouponReservation?

  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@index([status, paymentExpiresAt])
  // Teslim faturası backfill'inin aday sorgusu (faturasız + en yeni teslimat önce).
  @@index([status, revenueInvoicedAt, deliveredAt])
  @@index([checkoutGroupId])
  @@index([packageId])
  @@map("orders")
}

model CommissionLedger {
  id      String @id @default(uuid())
  orderId String @unique @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id])

  sellerCommission     Decimal @map("seller_commission") @db.Decimal(10, 2)
  buyerFee             Decimal @map("buyer_fee") @db.Decimal(10, 2)
  totalPlatformRevenue Decimal @map("total_platform_revenue") @db.Decimal(10, 2)

  // Kısmi (adet) iadede pro-rate edilen komisyon KÜMÜLATİF olarak burada birikir
  // (#88). Net = sellerCommission - refundedSellerCommission; original alanlar
  // DEĞİŞMEZ (tekrarlı kısmi iadeler compound olmasın). Tam iadede refunded = original.
  refundedSellerCommission Decimal @default(0) @map("refunded_seller_commission") @db.Decimal(10, 2)
  refundedBuyerFee         Decimal @default(0) @map("refunded_buyer_fee") @db.Decimal(10, 2)

  status       CommissionLedgerStatus @default(pending)
  earnedAt     DateTime?              @map("earned_at")
  refundedAt   DateTime?              @map("refunded_at")
  waivedAt     DateTime?              @map("waived_at")
  waivedReason String?                @map("waived_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([earnedAt])
  @@map("commission_ledger")
}

model Payment {
  id                     String            @id @default(uuid())
  orderId                String?           @unique @map("order_id")
  checkoutGroupId        String?           @unique @map("checkout_group_id")
  tradeCashPaymentId     String?           @unique @map("trade_cash_payment_id")
  provider               String
  providerPaymentId      String?           @map("provider_payment_id")
  providerConversationId String?           @map("provider_conversation_id")
  amount                 Decimal           @db.Decimal(10, 2)
  currency               String            @default("TRY")
  installmentCount       Int               @default(1) @map("installment_count")
  status                 PaymentStatus     @default(pending)
  failureReason          String?           @map("failure_reason")
  metadata               Json?
  paidAt                 DateTime?         @map("paid_at")
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")
  paymentHolds           PaymentHold[]
  refundAttempts         RefundAttempt[]
  order                  Order?            @relation(fields: [orderId], references: [id])
  checkoutGroup          CheckoutGroup?    @relation(fields: [checkoutGroupId], references: [id])
  tradeCashPayment       TradeCashPayment? @relation(fields: [tradeCashPaymentId], references: [id])

  @@map("payments")
}

model RefundAttempt {
  id                  String              @id @default(uuid())
  paymentId           String              @map("payment_id")
  orderId             String?             @map("order_id")
  tradeId             String?             @map("trade_id")
  idempotencyKey      String              @unique @map("idempotency_key")
  amount              Decimal             @db.Decimal(10, 2)
  provider            String
  providerReference   String?             @map("provider_reference")
  providerRefundId    String?             @map("provider_refund_id")
  providerResponse    Json?               @map("provider_response")
  status              RefundAttemptStatus @default(prepared)
  failureReason       String?             @map("failure_reason")
  requestStartedAt    DateTime?           @map("request_started_at")
  providerSucceededAt DateTime?           @map("provider_succeeded_at")
  finalizedAt         DateTime?           @map("finalized_at")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  payment             Payment             @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  order               Order?              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  trade               Trade?              @relation(fields: [tradeId], references: [id], onDelete: Restrict)

  @@index([paymentId, orderId])
  @@index([paymentId, tradeId])
  @@index([status, updatedAt])
  @@map("refund_attempts")
}

model PaymentHold {
  id               String            @id @default(uuid())
  paymentId        String            @map("payment_id")
  orderId          String            @map("order_id")
  sellerId         String            @map("seller_id")
  amount           Decimal           @db.Decimal(10, 2)
  status           PaymentHoldStatus @default(held)
  releaseAt        DateTime?         @map("release_at")
  releasedAt       DateTime?         @map("released_at")
  // Adet bazlı kısmi iadede tüketilen satıcı-payı toplamı. Satıcıya ödenecek
  // tutar = amount - refundedAmount. refundedAmount >= amount → hold tamamen tükendi.
  refundedAmount   Decimal           @default(0) @map("refunded_amount") @db.Decimal(10, 2)
  // Açık bir iade talebi varken hold'u atomik olarak kilitler: hiçbir release
  // yolu frozenByRefundId dolu bir hold'u serbest bırakamaz. İade reddedilir/
  // iptal edilirse temizlenir; iade tamamlanırsa hold consume edilir.
  frozenByRefundId String?           @map("frozen_by_refund_id")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  payment          Payment           @relation(fields: [paymentId], references: [id])
  seller           User              @relation(fields: [sellerId], references: [id])
  payoutTransfer   PayoutTransfer?   @relation("HoldPayoutTransfer")

  @@unique([paymentId, orderId])
  @@index([paymentId])
  // Grup dosyası + payouts artık hold'ları orderId ile sorguluyor.
  @@index([orderId])
  @@map("payment_holds")
}

model SellerBankAccount {
  id            String    @id @default(uuid())
  userId        String    @unique @map("user_id")
  accountHolder String    @map("account_holder")
  iban          String
  tcKimlikNo    String?   @map("tc_kimlik_no")
  taxId         String?   @map("tax_id")
  isVerified    Boolean   @default(false) @map("is_verified")
  verifiedAt    DateTime? @map("verified_at")
  // Son IBAN DEĞİŞİKLİĞİ zamanı (ilk kayıtta null). Payout, değişimden sonra kısa bir
  // bekleme (cooldown) uygular → çalınan oturumla IBAN'ı değiştirip anında para
  // çekme engellenir; satıcı değişiklik bildirimini görüp itiraz edebilir (F2.1).
  ibanChangedAt DateTime? @map("iban_changed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("seller_bank_accounts")
}

/// Kurumsal satıcı başvuru belgesi (vergi levhası, sözleşme, imza sirküleri,
/// faaliyet belgesi, kimlik). Private `documents` S3 bucket'ında saklanır (key);
/// admin presigned URL ile görüntüler. (userId, documentType) tekil → yeniden
/// yükleme eskisini değiştirir.
model SellerDocument {
  id            String                @id @default(uuid())
  userId        String                @map("user_id")
  applicationId String?               @map("application_id")
  stakeholderId String?               @map("stakeholder_id")
  documentType  SellerDocumentType    @map("document_type")
  s3Key         String                @map("s3_key")
  fileName      String                @map("file_name")
  mimeType      String                @map("mime_type")
  size          Int                   @default(0)
  status        SellerDocumentStatus  @default(pending)
  reviewNote    String?               @map("review_note")
  uploadedAt    DateTime              @default(now()) @map("uploaded_at")
  reviewedAt    DateTime?             @map("reviewed_at")
  reviewedBy    String?               @map("reviewed_by")
  appealNote    String?               @map("appeal_note")
  version       Int                   @default(1)
  isCurrent     Boolean               @default(true) @map("is_current")
  supersedesId  String?               @map("supersedes_id")
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  application   CorporateApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  stakeholder   CorporateStakeholder? @relation(fields: [stakeholderId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([applicationId, documentType, isCurrent])
  @@index([stakeholderId])
  @@map("seller_documents")
}

enum SellerDocumentType {
  tax_plate // vergi levhası
  contract // sözleşme
  signature_circular // imza sirküleri
  activity_certificate // faaliyet belgesi
  identity // eski birleşik kimlik belgesi
  identity_front
  identity_back
  passport_front
  passport_back
  residence_or_invoice
  trade_registry_gazette
  bank_account_info
}

enum SellerDocumentStatus {
  pending
  approved
  rejected
  revision_requested
  appealed
}

// PayTR CAPI kayıtlı kart (recurring/oto-yenileme için). PAN/CVV ASLA saklanmaz —
// yalnızca PayTR token'ları (utoken=kullanıcı, ctoken=kart) + maskeli bilgi tutulur.
model SavedCard {
  id                  String          @id @default(uuid())
  userId              String          @map("user_id")
  provider            String          @default("paytr")
  utoken              String          @map("u_token")
  ctoken              String          @unique @map("c_token")
  last4               String          @map("last_4")
  brand               String?
  // PayTR CAPI liste alanları (kayıtlı-kart-listesi dokümanı): kart gözlemlenebilirliği
  // + UX (banka/şema göster). PAN/CVV DEĞİL — yalnız maskeli/kart-meta bilgisi.
  bank                String? // PayTR c_bank — kartı çıkaran banka
  cardType            String?         @map("card_type") // PayTR c_type — credit/debit
  cardScheme          String?         @map("card_scheme") // PayTR schema — VISA/MASTERCARD/TROY/AMEX
  businessCard        Boolean?        @map("business_card") // PayTR businessCard — kurumsal kart (y/n)
  expMonth            String?         @map("exp_month")
  expYear             String?         @map("exp_year")
  requireCvv          Boolean         @default(false) @map("require_cvv")
  isDefault           Boolean         @default(false) @map("is_default")
  status              SavedCardStatus @default(active)
  mandateAcceptedAt   DateTime?       @map("mandate_accepted_at")
  mandateIp           String?         @map("mandate_ip")
  mandateTermsVersion String?         @map("mandate_terms_version")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@map("saved_cards")
}

enum SavedCardStatus {
  active
  expired
  revoked
}

// PayTR işlem dökümü satırı (rapor/islem-dokumu) — PSP mutabakatının işlem-seviyesi
// kaynağı. Gece sync'i dünün dökümünü (kayan 3 günlük pencereyle) upsert eder;
// admin mutabakat ekranı PayTR'ye canlı sorgu atmaz, bu tablodan okur.
// paymentId/refundAttemptId YUMUŞAK bağ (FK yok — PaymentProviderEvent ile aynı
// gerekçe): eşleştirme Faz 3'te doldurur, eşleşmeyen satır alarm listesine düşer.
model PaytrStatementLine {
  id              String                 @id @default(uuid())
  merchantOid     String                 @map("merchant_oid")
  type            PaytrStatementLineType
  amount          Decimal                @db.Decimal(12, 2)
  // PayTR'nin bu işlemden kestiği komisyon (kesinti_tutari/orani) ve kalan net.
  fee             Decimal?               @db.Decimal(12, 2)
  feeRate         Decimal?               @map("fee_rate") @db.Decimal(6, 3)
  net             Decimal?               @db.Decimal(12, 2)
  currency        String                 @default("TL")
  installment     Int?
  cardBrand       String?                @map("card_brand")
  maskedPan       String?                @map("masked_pan")
  paymentType     String?                @map("payment_type") // KART | EFT
  // İşlem günü (PayTR "GG.AA.YYYY" verir; gün hassasiyetinde saklanır).
  transactionDate DateTime               @map("transaction_date")
  matchStatus     PaytrMatchStatus       @default(unmatched) @map("match_status")
  paymentId       String?                @map("payment_id")
  refundAttemptId String?                @map("refund_attempt_id")
  // psp_fee_accrued ledger kaydı yazıldı mı (idempotens damgası) — Faz 5.
  ledgerRecordedAt DateTime?             @map("ledger_recorded_at")
  raw             Json?
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  // Dedup: kayan pencereli sync aynı satırı iki kez yazamaz. PayTR satır kimliği
  // vermediğinden doğal anahtar (oid+tip+gün+tutar) kullanılır.
  @@unique([merchantOid, type, transactionDate, amount], name: "statement_line_dedup")
  @@index([transactionDate])
  @@index([matchStatus])
  @@map("paytr_statement_lines")
}

enum PaytrStatementLineType {
  sale
  refund
}

enum PaytrMatchStatus {
  unmatched
  matched
  amount_mismatch
}

// PayTR hakediş (rapor/odeme-dokumu): mağaza hesabına aktarılan/aktarılacak günlük
// toplamlar. isProjection=true satırlar future_payments bloğundan gelir ve her
// sync'te sil-yaz yenilenir (PayTR projeksiyonu her gün günceller).
model PaytrSettlement {
  id           String                @id @default(uuid())
  datePaid     DateTime              @map("date_paid")
  currency     String                @default("TL")
  salesTotal   Decimal               @map("sales_total") @db.Decimal(12, 2)
  returnTotal  Decimal               @map("return_total") @db.Decimal(12, 2)
  netTotal     Decimal               @map("net_total") @db.Decimal(12, 2)
  merchantIban String?               @map("merchant_iban")
  isProjection Boolean               @default(false) @map("is_projection")
  raw          Json?
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")
  items        PaytrSettlementItem[]

  @@unique([datePaid, currency, isProjection], name: "settlement_day")
  @@index([datePaid])
  @@map("paytr_settlements")
}

// Hakediş kalemi (rapor/odeme-detayi): o günkü hakedişin içindeki sipariş dökümü.
// Yalnız kalemi olmayan gerçekleşmiş hakediş için bir kez çekilir.
model PaytrSettlementItem {
  id           String          @id @default(uuid())
  settlementId String          @map("settlement_id")
  merchantOid  String          @map("merchant_oid")
  amount       Decimal         @db.Decimal(12, 2)
  currency     String          @default("TL")
  paymentId    String?         @map("payment_id") // yumuşak bağ — Faz 3 eşleştirmesi doldurur
  raw          Json?
  createdAt    DateTime        @default(now()) @map("created_at")
  settlement   PaytrSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@index([settlementId])
  @@index([merchantOid])
  @@map("paytr_settlement_items")
}

// PSP (PayTR) etkileşim/yanıt kaydı — append-only denetim/gözlemlenebilirlik günlüğü.
// Her PayTR yanıtı (bildirim callback'i, Direkt API, recurring çekim, durum-sorgu, iade,
// kart listele/sil) yapısal alanlar + ham zarf ile buraya yazılır. Amaç: muhasebe/mutabakat
// (Faz 6.5 ledger vs PSP raporu), destek ("hangi kart/taksit"), itiraz/chargeback savunması,
// ödeme-yöntemi raporlaması. GÜVENLİK: PAN/CVV ASLA yazılmaz — PayTR yanıtları bunları içermez
// ve recorder yalnızca maskeli/meta alanları alır. paymentId/membershipPaymentId YUMUŞAK bağ
// (FK yok): re-init'te oid değişebilir ve kart listele/sil olaylarının ödemesi yoktur.
model PaymentProviderEvent {
  id                  String                   @id @default(uuid())
  provider            String                   @default("paytr")
  eventType           PaymentProviderEventType @map("event_type")
  merchantOid         String?                  @map("merchant_oid")
  paymentId           String?                  @map("payment_id")
  membershipPaymentId String?                  @map("membership_payment_id")
  status              String? // success/failed/wait_callback/error
  paymentType         String?                  @map("payment_type") // card/eft
  installmentCount    Int?                     @map("installment_count")
  currency            String?
  amount              Decimal?                 @db.Decimal(12, 2) // payment_amount (sipariş tutarı)
  totalAmount         Decimal?                 @map("total_amount") @db.Decimal(12, 2) // total_amount (çekilen)
  failedReasonCode    String?                  @map("failed_reason_code")
  failedReasonMsg     String?                  @map("failed_reason_msg")
  // PSP ücret mutabakatı (durum-sorgu kesinti_tutari / net_tutar): PayTR'nin bu
  // işlemden kestiği komisyon ve kesinti sonrası net. Ledger vs PSP raporu
  // karşılaştırması bu kolonlardan beslenir.
  providerFee         Decimal?                 @map("provider_fee") @db.Decimal(12, 2)
  providerNet         Decimal?                 @map("provider_net") @db.Decimal(12, 2)
  utoken              String?
  testMode            Boolean?                 @map("test_mode")
  hashValid           Boolean?                 @map("hash_valid") // yalnız callback: hash doğrulaması geçti mi
  raw                 Json? // ham PayTR zarfı (PAN/CVV içermez; 3DS HTML saklanmaz)
  createdAt           DateTime                 @default(now()) @map("created_at")

  @@index([merchantOid])
  @@index([paymentId])
  @@index([membershipPaymentId])
  @@index([provider, eventType, createdAt])
  @@map("payment_provider_events")
}

enum PaymentProviderEventType {
  callback // Bildirim URL POST (ödeme sonucu)
  direct_payment // /odeme Direkt API (CIT yeni kart) yanıtı
  recurring_charge // recurring_payment=1 (kayıtlı kart / oto-yenileme) yanıtı
  status_inquiry // durum-sorgu yanıtı
  refund // /odeme/iade yanıtı
  card_list // capi/list yanıtı
  card_delete // capi/delete yanıtı
}

model PayoutTransfer {
  id                     String                        @id @default(uuid())
  paymentHoldId          String?                       @unique @map("payment_hold_id")
  tradeCashPaymentId     String?                       @unique @map("trade_cash_payment_id")
  sellerId               String                        @map("seller_id")
  amount                 Decimal                       @db.Decimal(10, 2)
  commission             Decimal                       @db.Decimal(10, 2)
  // Sipariş anında hesaplanan e-ticaret stopajı snapshot'ı (muhtasar raporu bu alandan beslenir).
  withholdingTax         Decimal                       @default(0) @map("withholding_tax") @db.Decimal(10, 2)
  netAmount              Decimal                       @map("net_amount") @db.Decimal(10, 2)
  adjustmentDeduction    Decimal                       @default(0) @map("adjustment_deduction") @db.Decimal(10, 2)
  currency               String                        @default("TRY")
  merchantOid            String                        @map("merchant_oid")
  transId                String                        @unique @map("trans_id")
  transferIban           String                        @map("transfer_iban")
  transferName           String                        @map("transfer_name")
  status                 PayoutStatus                  @default(pending)
  providerResponse       Json?                         @map("provider_response")
  failureReason          String?                       @map("failure_reason")
  retryCount             Int                           @default(0) @map("retry_count")
  maxRetries             Int                           @default(3) @map("max_retries")
  nextRetryAt            DateTime?                     @map("next_retry_at")
  // PayTR aşama-1 (talimat kabulü) anı ve o an GERÇEKTEN gönderilen net tutar.
  // Aşama-2 callback'i saatler/günler sonra gelir; mail + ledger o anki
  // netAmount'a değil bu snapshot'a bakar (adjustment/iade netAmount'ı değiştirebilir).
  // submittedAt doluysa payout PayTR'ye iletilmiştir → zombi tespiti bunu takılı saymaz.
  submittedAt            DateTime?                     @map("submitted_at")
  submittedAmount        Decimal?                      @map("submitted_amount") @db.Decimal(10, 2)
  processedAt            DateTime?                     @map("processed_at")
  createdAt              DateTime                      @default(now()) @map("created_at")
  updatedAt              DateTime                      @updatedAt @map("updated_at")
  paymentHold            PaymentHold?                  @relation("HoldPayoutTransfer", fields: [paymentHoldId], references: [id])
  tradeCashPayment       TradeCashPayment?             @relation("TradeCashPayoutTransfers", fields: [tradeCashPaymentId], references: [id])
  seller                 User                          @relation("SellerPayoutTransfers", fields: [sellerId], references: [id])
  adjustmentApplications SellerAdjustmentApplication[]

  @@index([sellerId])
  @@index([status])
  @@index([processedAt])
  @@map("payout_transfers")
}

model SellerAccountAdjustment {
  id              String                        @id @default(uuid())
  sellerId        String                        @map("seller_id")
  orderId         String?                       @map("order_id")
  refundRequestId String?                       @map("refund_request_id")
  sourceKey       String                        @unique @map("source_key")
  type            SellerAdjustmentType
  amount          Decimal                       @db.Decimal(10, 2)
  remainingAmount Decimal                       @map("remaining_amount") @db.Decimal(10, 2)
  status          SellerAdjustmentStatus        @default(open)
  metadata        Json?
  settledAt       DateTime?                     @map("settled_at")
  createdAt       DateTime                      @default(now()) @map("created_at")
  updatedAt       DateTime                      @updatedAt @map("updated_at")
  applications    SellerAdjustmentApplication[]

  @@index([sellerId, status, createdAt])
  @@index([orderId])
  @@index([refundRequestId])
  @@map("seller_account_adjustments")
}

model SellerAdjustmentApplication {
  id               String                  @id @default(uuid())
  adjustmentId     String                  @map("adjustment_id")
  payoutTransferId String                  @map("payout_transfer_id")
  amount           Decimal                 @db.Decimal(10, 2)
  createdAt        DateTime                @default(now()) @map("created_at")
  adjustment       SellerAccountAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Restrict)
  payoutTransfer   PayoutTransfer          @relation(fields: [payoutTransferId], references: [id], onDelete: Restrict)

  @@unique([adjustmentId, payoutTransferId])
  @@index([payoutTransferId])
  @@map("seller_adjustment_applications")
}

model Invoice {
  id            String    @id @default(uuid())
  invoiceNumber String    @unique @map("invoice_number")
  orderId       String    @unique @map("order_id")
  buyerId       String    @map("buyer_id")
  sellerId      String    @map("seller_id")
  subtotal      Decimal   @db.Decimal(10, 2)
  taxAmount     Decimal   @default(0) @map("tax_amount") @db.Decimal(10, 2)
  shippingCost  Decimal   @default(0) @map("shipping_cost") @db.Decimal(10, 2)
  total         Decimal   @db.Decimal(10, 2)
  pdfUrl        String?   @map("pdf_url")
  status        String    @default("issued")
  issuedAt      DateTime  @map("issued_at")
  cancelledAt   DateTime? @map("cancelled_at")
  cancelReason  String?   @map("cancel_reason")
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  buyer         User      @relation("BuyerInvoices", fields: [buyerId], references: [id])
  order         Order     @relation(fields: [orderId], references: [id])
  seller        User      @relation("SellerInvoices", fields: [sellerId], references: [id])

  @@index([buyerId])
  @@index([sellerId])
  @@index([invoiceNumber])
  @@map("invoices")
}

/// Tarodan'ın KENDİ gelir e-belgeleri (komisyon / hizmet bedeli / üyelik / boost / iade).
/// Düzenleyen = platform firması (Serhatlar). Mevcut Invoice (sipariş makbuzu) ile
/// KARIŞTIRILMAMALI — bu model yalnızca eLogo'ya gönderilen GİB e-Arşiv/e-Fatura'yı izler.
/// İlişki (User/Order) bilerek eklenmedi (daha az invaziv); kimlikler düz alan olarak tutulur.
/// Tutarlar olay anındaki KAYITLI snapshot'tan gelir (oran/fiyat sonradan değişse de etkilenmez).
model ElogoInvoice {
  id                        String             @id @default(uuid())
  type                      ElogoInvoiceType
  /// Kaynak kaydın id'si (orderId / membershipPaymentId / boostId). type+sourceId tekil → idempotency.
  sourceId                  String             @map("source_id")
  recipientUserId           String?            @map("recipient_user_id")
  recipientVknTckn          String?            @map("recipient_vkn_tckn")
  recipientName             String?            @map("recipient_name")
  // Misafir siparişleri tek sistem kullanıcısını paylaşır; gönderim anında alıcıyı
  // kullanıcı kaydından çözmek faturayı sistem e-postasına/boş adrese yazıyordu.
  // Kesim anındaki GERÇEK iletişim bilgisi burada snapshot'lanır.
  recipientEmail            String?            @map("recipient_email")
  recipientCity             String?            @map("recipient_city")
  recipientDistrict         String?            @map("recipient_district")
  recipientStreet           String?            @map("recipient_street")
  documentType              String             @default("EARCHIVE") @map("document_type") // EARCHIVE | EINVOICE
  sendType                  String             @default("ELEKTRONIK") @map("send_type")
  invoiceNumber             String?            @unique @map("invoice_number")
  ettn                      String?            @unique
  netAmount                 Decimal            @map("net_amount") @db.Decimal(10, 2)
  taxAmount                 Decimal            @map("tax_amount") @db.Decimal(10, 2)
  total                     Decimal            @db.Decimal(10, 2)
  /// İlk oluşturma anındaki brüt tutar. Pending belge iadede netleştirilse bile
  /// tekrarlı kısmi iadeler bu immutable baz üzerinden hesaplanır.
  originalTotal             Decimal            @map("original_total") @db.Decimal(10, 2)
  vatRate                   Decimal            @default(20) @map("vat_rate") @db.Decimal(5, 2)
  status                    ElogoInvoiceStatus @default(pending)
  elogoRefId                String?            @map("elogo_ref_id")
  elogoResultCode           Int?               @map("elogo_result_code")
  elogoResultMsg            String?            @map("elogo_result_msg")
  /// İADE faturasında iadesi yapılan orijinal faturanın numarası.
  billingReference          String?            @map("billing_reference")
  /// İADE faturasında referans verilen orijinal faturanın düzenlenme tarihi.
  /// Retry sırasında "bugünün tarihi" kullanılmaması için immutable snapshot.
  billingReferenceIssueDate DateTime?          @map("billing_reference_issue_date")
  /// Fatura kaleminin açıklaması — kesim anında snapshot'lanır (ör. boost için
  /// paket adını içerir). Boşsa tipin varsayılan etiketi (LINE_DESCRIPTION) kullanılır.
  lineDescription           String?            @map("line_description")
  /// eLogo'dan çekilip S3'e kaydedilen PDF'in S3 anahtarı (documents bucket).
  pdfUrl                    String?            @map("pdf_url")
  /// PDF alıcıya kendi SMTP'mizden e-postalandığı an.
  emailSentAt               DateTime?          @map("email_sent_at")
  attemptCount              Int                @default(0) @map("attempt_count")
  lastAttemptAt             DateTime?          @map("last_attempt_at")
  /// Pending/failed belgenin hangi refund finalize anına kadar netleştirildiği.
  refundAdjustedAt          DateTime?          @map("refund_adjusted_at")
  issuedAt                  DateTime?          @map("issued_at")
  sentAt                    DateTime?          @map("sent_at")
  cancelledAt               DateTime?          @map("cancelled_at")
  cancelReason              String?            @map("cancel_reason")
  createdAt                 DateTime           @default(now()) @map("created_at")
