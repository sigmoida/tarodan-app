/// Kurumsal (şirket) satıcının siparişe elle yüklediği ÜRÜN faturası PDF'i.
/// Tarodan'ın eLogo gelir e-Arşivlerinden (komisyon/hizmet) AYRI; satıcının kendi
/// sisteminden kestiği fatura. Sipariş başına TEK (orderId @unique); değiştirilebilir.
model SellerUploadedInvoice {
