/// AI moderasyon olay günlüğü — tüm varlıklar için ortak (ürün/kullanıcı/koleksiyon/yükleme).
/// Polimorfik (entityType + entityId) ve FK içermez: hedef varlık silinse de denetim kaydı kalır.
/// Yazma anında engellenen görsel/metin (decision=blocked) ve ürün worker sonuçları (pass/review/flag) buraya yazılır.
model ModerationEvent {
  id             String   @id @default(uuid())
  entityType     String   @map("entity_type") // product | user | collection | upload | message
  entityId       String?  @map("entity_id")
  userId         String?  @map("user_id") // içeriği üreten/yükleyen kullanıcı
  kind           String // image | text
  field          String? // avatar | bio | display_name | cover | item | product_image | message_image | upload
  decision       String // pass | review | flag | blocked
  relevanceScore Float?   @map("relevance_score")
  nsfwScore      Float?   @map("nsfw_score")
  labels         Json?
  reason         String?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([entityType, decision])
  @@index([userId])
  @@index([createdAt])
  @@map("moderation_events")
}

