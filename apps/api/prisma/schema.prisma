  sender          User          @relation("MessageSender", fields: [senderId], references: [id])
  thread          MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([senderId])
  @@index([receiverId])
  @@index([status])
  @@map("messages")
}

model ContentFilter {
  id               String   @id @default(uuid())
  filterType       String   @map("filter_type")
