model PaymentHold {
  id             String            @id @default(uuid())
  paymentId      String            @map("payment_id")
  orderId        String            @map("order_id")
  sellerId       String            @map("seller_id")
  amount         Decimal           @db.Decimal(10, 2)
  status         PaymentHoldStatus @default(held)
  releaseAt      DateTime?         @map("release_at")
  releasedAt     DateTime?         @map("released_at")
  // Adet bazlı kısmi iadede tüketilen satıcı-payı toplamı. Satıcıya ödenecek
  // tutar = amount - refundedAmount. refundedAmount >= amount → hold tamamen tükendi.
  refundedAmount Decimal           @default(0) @map("refunded_amount") @db.Decimal(10, 2)
  // Açık bir iade talebi varken hold'u atomik olarak kilitler: hiçbir release
  // yolu frozenByRefundId dolu bir hold'u serbest bırakamaz. İade reddedilir/
  // iptal edilirse temizlenir; iade tamamlanırsa hold consume edilir.
  frozenByRefundId String?         @map("frozen_by_refund_id")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  payment        Payment           @relation(fields: [paymentId], references: [id])
  seller         User              @relation(fields: [sellerId], references: [id])
  payoutTransfer PayoutTransfer?   @relation("HoldPayoutTransfer")

  @@unique([paymentId, orderId])
  @@index([paymentId])
  @@map("payment_holds")
}

