  @@map("shipment_events")
}

model RefundRequest {
  id                String              @id @default(uuid())
  refundNumber      String              @unique @map("refund_number")
  orderId           String              @map("order_id")
  requesterId       String              @map("requester_id")
  reason            RefundReason
  description       String?
  evidencePhotoUrls String[]            @default([]) @map("evidence_photo_urls")
  amount            Decimal             @db.Decimal(10, 2)
  /// Adet bazlı kısmi iade: order.quantity'nin kaç adedi iade ediliyor (default = tümü).
  refundQuantity    Int                 @default(1) @map("refund_quantity")
  status            RefundRequestStatus @default(approved)

  sellerResponse String?   @map("seller_response")
  decidedBy      String?   @map("decided_by")
  decidedAt      DateTime? @map("decided_at")

  returnProvider           String?         @map("return_provider")
  // returnTrackingNumber = OzelKargoTakipNo (refundNumber; poller sorgu anahtarı).
  returnTrackingNumber     String?         @map("return_tracking_number")
  // Gerçek Sürat iade kodu (KargoTakipNo) + ZPL etiket (OrtakBarkodOlustur).
  returnProviderTrackingId String?         @map("return_provider_tracking_id")
  returnLabelZpl           String?         @map("return_label_zpl")
  returnStatus             ShipmentStatus? @map("return_status")
  returnShippedAt          DateTime?       @map("return_shipped_at")
  returnDeliveredAt        DateTime?       @map("return_delivered_at")
  returnCreatedAt          DateTime?       @map("return_created_at")

  refundedAt       DateTime? @map("refunded_at")
  providerRefundId String?   @map("provider_refund_id")

  // Talep oluşturulduğu andaki değişmez finansal karar. Admin ekranı, ödeme,
  // komisyon, hold ve fatura akışları aynı TL kırılımını kullanır.
  policyCode                      String  @default("legacy") @map("policy_code")
  financialPolicySnapshot         Json?   @map("financial_policy_snapshot")
  returnBillableDesi              Int     @default(1) @map("return_billable_desi")
  returnShippingAmount            Decimal @default(0) @map("return_shipping_amount") @db.Decimal(10, 2)
  refundedProductAmount           Decimal @default(0) @map("refunded_product_amount") @db.Decimal(10, 2)
  refundedOutboundShippingAmount  Decimal @default(0) @map("refunded_outbound_shipping_amount") @db.Decimal(10, 2)
  refundedBuyerProtectionAmount   Decimal @default(0) @map("refunded_buyer_protection_amount") @db.Decimal(10, 2)
  refundedSellerFeeAmount         Decimal @default(0) @map("refunded_seller_fee_amount") @db.Decimal(10, 2)
  retainedSellerPlatformFeeAmount Decimal @default(0) @map("retained_seller_platform_fee_amount") @db.Decimal(10, 2)
  returnShippingChargeToBuyer     Decimal @default(0) @map("return_shipping_charge_to_buyer") @db.Decimal(10, 2)
  returnShippingChargeToSeller    Decimal @default(0) @map("return_shipping_charge_to_seller") @db.Decimal(10, 2)
  // Escrow hold'dan TAM kargo düşüldüğü için satıcı kendi payını peşin ödemiş sayılır.
  // Kusur alıcıdaysa / gönderi hiç taşınmadıysa bu pay hold'da satıcıya BIRAKILIR.
  sellerShippingCompensationAmount Decimal @default(0) @map("seller_shipping_compensation_amount") @db.Decimal(10, 2)
  // Alıcıya geri ödenen gidiş kargosu: Sürat faturası platformda olduğundan kusur
  // satıcıdayken satıcıya borç yazılır (payout mahsubu).
  outboundShippingChargeToSeller   Decimal @default(0) @map("outbound_shipping_charge_to_seller") @db.Decimal(10, 2)
  requiresAdminReview             Boolean @default(false) @map("requires_admin_review")
  penaltyReviewRequired           Boolean @default(false) @map("penalty_review_required")

  refundProductAmount    Boolean              @default(true) @map("refund_product_amount")
  refundShippingFee      Boolean              @default(true) @map("refund_shipping_fee")
  refundBuyerFee         Boolean              @default(true) @map("refund_buyer_fee")
  refundSellerCommission Boolean              @default(true) @map("refund_seller_commission")
  returnShippingPayer    ReturnShippingPayer? @map("return_shipping_payer")
  buyerInitiatedAmicable Boolean              @default(false) @map("buyer_initiated_amicable")

  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  order     Order @relation(fields: [orderId], references: [id])
  requester User  @relation("UserRefundRequests", fields: [requesterId], references: [id])

  @@index([orderId])
  @@index([requesterId])
  @@index([status])
  @@index([refundNumber])
  @@map("refund_requests")
}

model CommissionRule {
  id             String                @id @default(uuid())
  name           String
  ruleType       CommissionRuleType    @map("rule_type")
  categoryId     String?               @map("category_id")
  membershipTier MembershipTierType?   @map("membership_tier")
  minAmount      Decimal?              @map("min_amount") @db.Decimal(10, 2)
  percentage     Decimal               @db.Decimal(7, 4)
  minCommission  Decimal?              @map("min_commission") @db.Decimal(10, 2)
  maxCommission  Decimal?              @map("max_commission") @db.Decimal(10, 2)
  isActive       Boolean               @default(true) @map("is_active")
  priority       Int                   @default(0)
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  appliesTo      CommissionAppliesTo   @default(SELLER) @map("applies_to")
  buyerMax       Decimal?              @map("buyer_max") @db.Decimal(10, 2)
  buyerMin       Decimal?              @map("buyer_min") @db.Decimal(10, 2)
  buyerRate      Decimal?              @map("buyer_rate") @db.Decimal(7, 4)
  sellerMax      Decimal?              @map("seller_max") @db.Decimal(10, 2)
  sellerMin      Decimal?              @map("seller_min") @db.Decimal(10, 2)
  sellerRate     Decimal?              @map("seller_rate") @db.Decimal(7, 4)
  sellerType     CommissionSellerType? @map("seller_type")

  // ── v2 (kesinti profili) ──
  // Ek eşleşme ekseni: bireysel/kurumsal (businessStatus+taxId), üyelikten (sellerType) bağımsız.
  taxpayerType          CommissionTaxpayerType @default(all) @map("taxpayer_type")
  // Kademeli eşleşme: ürün/satır tutarı [minAmount, maxAmount] aralığı (minAmount legacy sütunu yeniden kullanılır).
  maxAmount             Decimal?               @map("max_amount") @db.Decimal(12, 2)
  // Dört ayrı kesinti oranı (%) + opsiyonel TL taban/tavan.
  buyerCommissionRate   Decimal?               @map("buyer_commission_rate") @db.Decimal(7, 4)
  buyerCommissionMin    Decimal?               @map("buyer_commission_min") @db.Decimal(10, 2)
  buyerCommissionMax    Decimal?               @map("buyer_commission_max") @db.Decimal(10, 2)
  buyerServiceFeeRate   Decimal?               @map("buyer_service_fee_rate") @db.Decimal(7, 4)
  buyerServiceFeeMin    Decimal?               @map("buyer_service_fee_min") @db.Decimal(10, 2)
  buyerServiceFeeMax    Decimal?               @map("buyer_service_fee_max") @db.Decimal(10, 2)
  sellerCommissionRate  Decimal?               @map("seller_commission_rate") @db.Decimal(7, 4)
  sellerCommissionMin   Decimal?               @map("seller_commission_min") @db.Decimal(10, 2)
  sellerCommissionMax   Decimal?               @map("seller_commission_max") @db.Decimal(10, 2)
  sellerPlatformFeeRate Decimal?               @map("seller_platform_fee_rate") @db.Decimal(7, 4)
  sellerPlatformFeeMin  Decimal?               @map("seller_platform_fee_min") @db.Decimal(10, 2)
  sellerPlatformFeeMax  Decimal?               @map("seller_platform_fee_max") @db.Decimal(10, 2)
  // Tek kargo tutarının alıcı payı (%). Satıcı payı = 100 - buyerShare. Varsayılan 100 = alıcı öder (mevcut davranış).
  // Kademe bazlı pay (shippingShares) tanımlanmamışsa bu değer TÜM kademelere uygulanır.
  shippingBuyerShare    Decimal                @default(100) @map("shipping_buyer_share") @db.Decimal(5, 2)
  // TAKAS sabit hizmet bedelleri (₺, KDV DAHİL — oran/KDV hesabı YOK; sipariş
  // ücretlerinden bilinçli fark). Bu kurala düşen bir ürün takasa girdiğinde:
  // ürünü VEREN taraf `tradeFeeSellerAmount`, ALAN taraf `tradeFeeBuyerAmount`
  // öder. Null = o kalem 0. Takas eşleşmesinde satıcı tipi/mükellefiyet
  // eksenleri joker geçilir (takasta alıcı/satıcı hesabı yoktur).
  tradeFeeSellerAmount  Decimal?               @map("trade_fee_seller_amount") @db.Decimal(10, 2)
  tradeFeeBuyerAmount   Decimal?               @map("trade_fee_buyer_amount") @db.Decimal(10, 2)

  category Category? @relation(fields: [categoryId], references: [id])
  // Paket boyutu başına ayrı alıcı/satıcı bölüşümü (örn. Küçük 100/0, Büyük 50/50).
  shippingShares CommissionRuleShippingShare[]

  @@index([isActive])
  @@index([categoryId, sellerType, isActive])
  @@index([sellerType, isActive])
  @@index([categoryId, taxpayerType, sellerType, isActive])
  @@map("commission_rules")
}

/// Bir komisyon kuralının paket boyutu başına kargo bölüşümü. Satır yoksa
/// kuralın tek `shippingBuyerShare` değeri geçerlidir (kolaylık fallback'i).
model CommissionRuleShippingShare {
  id         String                  @id @default(uuid())
  ruleId     String                  @map("rule_id")
  tierCode   ShippingPackageTierCode @map("tier_code")
  /// Alıcının payı (%); satıcı payı = 100 - buyerShare.
  buyerShare Decimal                 @default(100) @map("buyer_share") @db.Decimal(5, 2)
  createdAt  DateTime                @default(now()) @map("created_at")
  updatedAt  DateTime                @updatedAt @map("updated_at")
  rule       CommissionRule          @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, tierCode])
  @@index([ruleId])
  @@map("commission_rule_shipping_shares")
}

