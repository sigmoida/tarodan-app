/// Tarodan'ın KENDİ gelir e-belgeleri (komisyon / hizmet bedeli / üyelik / boost / iade).
/// Düzenleyen = platform firması (Serhatlar). Mevcut Invoice (sipariş makbuzu) ile
/// KARIŞTIRILMAMALI — bu model yalnızca eLogo'ya gönderilen GİB e-Arşiv/e-Fatura'yı izler.
/// İlişki (User/Order) bilerek eklenmedi (daha az invaziv); kimlikler düz alan olarak tutulur.
/// Tutarlar olay anındaki KAYITLI snapshot'tan gelir (oran/fiyat sonradan değişse de etkilenmez).
model ElogoInvoice {
  id               String             @id @default(uuid())
  type             ElogoInvoiceType
  /// Kaynak kaydın id'si (orderId / membershipPaymentId / boostId). type+sourceId tekil → idempotency.
  sourceId         String             @map("source_id")
  recipientUserId  String?            @map("recipient_user_id")
  recipientVknTckn String?            @map("recipient_vkn_tckn")
  recipientName    String?            @map("recipient_name")
  documentType     String             @default("EARCHIVE") @map("document_type") // EARCHIVE | EINVOICE
  sendType         String             @default("ELEKTRONIK") @map("send_type")
  invoiceNumber    String?            @unique @map("invoice_number")
  ettn             String?            @unique
  netAmount        Decimal            @map("net_amount") @db.Decimal(10, 2)
  taxAmount        Decimal            @map("tax_amount") @db.Decimal(10, 2)
  total            Decimal            @db.Decimal(10, 2)
  vatRate          Decimal            @default(20) @map("vat_rate") @db.Decimal(5, 2)
  status           ElogoInvoiceStatus @default(pending)
  elogoRefId       String?            @map("elogo_ref_id")
  elogoResultCode  Int?               @map("elogo_result_code")
  elogoResultMsg   String?            @map("elogo_result_msg")
  /// İADE faturasında iadesi yapılan orijinal faturanın numarası.
  billingReference String?            @map("billing_reference")
  /// eLogo'dan çekilip S3'e kaydedilen PDF'in S3 anahtarı (documents bucket).
  pdfUrl           String?            @map("pdf_url")
  /// PDF alıcıya kendi SMTP'mizden e-postalandığı an.
  emailSentAt      DateTime?          @map("email_sent_at")
  attemptCount     Int                @default(0) @map("attempt_count")
  lastAttemptAt    DateTime?          @map("last_attempt_at")
  issuedAt         DateTime?          @map("issued_at")
  sentAt           DateTime?          @map("sent_at")
  cancelledAt      DateTime?          @map("cancelled_at")
  cancelReason     String?            @map("cancel_reason")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  @@unique([type, sourceId])
  @@index([status])
  @@index([recipientUserId])
  @@map("elogo_invoices")
}

/// Gap-free belge numarası sırası (prefix + yıl bazında). GİB zorunluluğu.
model ElogoDocSequence {
  id        String @id @default(uuid())
  prefix    String
  year      Int
  lastValue Int    @default(0) @map("last_value")

  @@unique([prefix, year])
  @@map("elogo_doc_sequences")
