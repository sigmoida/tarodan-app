model Shipment {
  id                  String          @id @default(uuid())
  orderId             String          @unique @map("order_id")
  // KOLİ bağı: bir OrderPackage = bir fiziksel gönderi, ama kayıt hâlâ sipariş
  // başınadır (iade/escrow/muhasebe sipariş bazlı). Aynı packageId'yi paylaşan
  // satırlar AYNI koliyi temsil eder → Sürat tek kez sorgulanır, webhook tüm
  // kardeşlere yayılır. Nullable: paketsiz (eski/manuel) kayıtlar için.
  packageId           String?         @map("package_id")
  provider            String
  trackingNumber      String?         @map("tracking_number")
  trackingUrl         String?         @map("tracking_url")
  labelUrl            String?         @map("label_url")
  cost                Decimal?        @db.Decimal(10, 2)
  // Faz 2 taşıyıcı mutabakatı: müşteriden alınan kargo (cost) ile Sürat'ın GERÇEK
  // faturaladığı tutar ayrı tutulur. Sürat takip cevabındaki Tutar/TutarKdvsiz/KdvTutar/
  // ToplamDesiKg her poll'de geliyordu ama düşürülüyordu; artık buraya yazılır.
  quotedCarrierCost   Decimal?        @map("quoted_carrier_cost") @db.Decimal(10, 2)
  carrierActualCost   Decimal?        @map("carrier_actual_cost") @db.Decimal(10, 2)
  carrierNetCost      Decimal?        @map("carrier_net_cost") @db.Decimal(10, 2)
  carrierTaxAmount    Decimal?        @map("carrier_tax_amount") @db.Decimal(10, 2)
  carrierDesi         Decimal?        @map("carrier_desi") @db.Decimal(10, 3)
  carrierCostSyncedAt DateTime?       @map("carrier_cost_synced_at")
  status              ShipmentStatus  @default(pending)
  estimatedDelivery   DateTime?       @map("estimated_delivery")
  shippedAt           DateTime?       @map("shipped_at")
  deliveredAt         DateTime?       @map("delivered_at")
  providerTrackingId  String?         @map("provider_tracking_id")
  providerStatusCode  Int?            @map("provider_status_code")
  providerRawStatus   String?         @map("provider_raw_status")
  // Raw ZPL label from OrtakBarkodOlustur (stored for future printing; not shown in UI).
  labelZpl            String?         @map("label_zpl")
  receivedBy          String?         @map("received_by")
  returnReason        String?         @map("return_reason")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  events              ShipmentEvent[]
  order               Order           @relation(fields: [orderId], references: [id])
  orderPackage        OrderPackage?   @relation(fields: [packageId], references: [id])

  @@index([packageId])
  @@map("shipments")
}

// Tipli, versiyonlanmış kargo tarifesi — kargo fiyatlandırmasının TEK kaynağı.
// Generic PlatformSetting anahtarlarının (shipping_base_cost / free_shipping_threshold)
// yerini alır. "Tam bedel" burada tutulur; alıcı/satıcı payı komisyon kuralındaki
// shippingBuyerShare ile ayrışır; iade kararları iade politikasında kalır.
// Provider başına aynı anda yalnız BİR active tarife olur (kısmi unique index).
// Sipariş oluşturulurken OrderPackage'a tariffId + version snapshot'ı alınır.
model ShippingTariff {
  id                    String               @id @default(uuid())
  provider              String               @default("surat")
  name                  String
  status                ShippingTariffStatus @default(draft)
  // Provider başına monoton artan sürüm; snapshot bu değeri saklar (audit + reconstruct).
  version               Int                  @default(1)
  currency              String               @default("TRY")
  freeShippingEnabled   Boolean              @default(true) @map("free_shipping_enabled")
  freeShippingThreshold Decimal              @map("free_shipping_threshold") @db.Decimal(10, 2)
  effectiveFrom         DateTime             @map("effective_from")
  createdBy             String?              @map("created_by")
  updatedBy             String?              @map("updated_by")
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")
  // Satıcının ilanda seçtiği paket boyutları. Tarifeye bağlı olduğu için
  // versiyonlama + aktif-tarife dokunulmazlığı + sipariş snapshot'ı miras alınır.
  packageTiers          ShippingPackageTier[]

  @@unique([provider, version])
  @@index([provider, status])
  @@map("shipping_tariffs")
}

/// Satıcıya gösterilen paket boyutu (Küçük/Orta/Büyük). Desi yalnız admin
/// tarafında görünür: satıcı boyut seçer, fiyat aralıktan çözülür.
model ShippingPackageTier {
  id       String                  @id @default(uuid())
  tariffId String                  @map("tariff_id")
  code     ShippingPackageTierCode
  /// Satıcıya gösterilen ad ("Küçük Paket") — admin düzenleyebilir.
  label    String
  /// Kapsanan desi aralığı; maxDesi null = üst sınırsız (son kademe).
  minDesi  Int                     @map("min_desi")
  maxDesi  Int?                    @map("max_desi")
  amount   Decimal                 @db.Decimal(10, 2)
  /// Satıcıya ipucu olarak gösterilen örnek ölçü (cm); yalnız metin, görsel yok.
  sampleWidth  Int? @map("sample_width")
  sampleHeight Int? @map("sample_height")
  sampleLength Int? @map("sample_length")
  sortOrder    Int  @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  tariff       ShippingTariff @relation(fields: [tariffId], references: [id], onDelete: Cascade)

  @@unique([tariffId, code])
  @@index([tariffId])
  @@map("shipping_package_tiers")
}


model ShipmentEvent {
  id          String   @id @default(uuid())
