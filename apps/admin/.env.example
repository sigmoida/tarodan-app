# =============================================================================
# Tarodan Admin (Next.js) — environment template
#
# Copy to apps/admin/.env.local for development. Production values live in
# Coolify and are validated by apps/admin/env.config.js at startup.
#
# IMPORTANT — build-time vs runtime:
#   NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time and
#   are passed as Docker ARGs (see apps/admin/Dockerfile). Changing one in
#   Coolify requires a REBUILD; a restart alone has no effect. They are also
#   publicly visible — never put a secret in a NEXT_PUBLIC_ variable.
#   Everything else is read at runtime by the Node server and stays private.
#
# The admin app holds no provider credentials of its own: every PayTR, Sürat and
# eLogo operation is proxied through the API. Its only real configuration is
# where the API lives and how cookies are issued.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
# Set by the Dockerfile in deployments.
PORT=3002
# Server-to-server API base used by server components and route handlers. Lets
# the container reach the API over the internal network instead of the public
# hostname. Falls back to NEXT_PUBLIC_API_URL when empty.
API_INTERNAL_URL=http://localhost:3001
# true in deployments (HTTPS); false for local HTTP.
COOKIE_SECURE=false

# -----------------------------------------------------------------------------
# Public URLs (BUILD TIME — rebuild after changing)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3002

# -----------------------------------------------------------------------------
# Sentry
# -----------------------------------------------------------------------------
# Client-side DSN (build time, public).
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Derived from the git SHA by sentry.release.ts when left empty.
NEXT_PUBLIC_SENTRY_RELEASE=
# Server-side DSN (runtime, private).
SENTRY_DSN=
# Source map upload — build time only, never needed at runtime. Keep secret.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=tarodan
SENTRY_PROJECT=admin
