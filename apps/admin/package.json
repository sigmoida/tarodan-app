{
  "name": "@tarodan/admin",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "template:products": "node ../api/scripts/generate-product-import-template.mjs",
    "dev": "pnpm run template:products && node ../../scripts/sync-brand-assets.mjs public && next dev -p 3002",
    "build": "pnpm run template:products && node ../../scripts/sync-brand-assets.mjs public && next build",
    "start": "next start -p 3002",
    "lint": "next lint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:api": "node scripts/check-api-collisions.mjs",
    "sync:brand": "node ../../scripts/sync-brand-assets.mjs public"
  },
  "dependencies": {
    "@heroicons/react": "^2.1.1",
    "@hookform/resolvers": "^3.3.4",
    "@opentelemetry/core": "1.30.1",
    "@opentelemetry/sdk-trace-base": "1.30.1",
    "@sentry/nextjs": "^8.55.2",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-table": "^8.11.2",
    "@tarodan/api-client": "workspace:*",
    "@tarodan/auth": "workspace:*",
    "@tarodan/brand": "workspace:*",
    "@tarodan/design-tokens": "workspace:*",
    "@tarodan/i18n": "workspace:*",
    "@tarodan/listing-form": "workspace:*",
    "@tarodan/logger": "workspace:*",
    "@tarodan/shared": "workspace:*",
    "@tarodan/types": "workspace:*",
    "@tarodan/ui": "workspace:*",
    "axios": "^1.20.0",
    "chart.js": "^4.4.1",
    "clsx": "^2.1.0",
    "date-fns": "^3.6.0",
    "framer-motion": "11.18.2",
    "next": "15.5.21",
    "next-intl": "^3",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.86.0",
    "react-hot-toast": "^2.4.1",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tarodan/eslint-config": "workspace:*",
    "@tarodan/eslint-plugin": "workspace:*",
    "@tarodan/tsconfig": "workspace:*",
    "@types/node": "^20.19.43",
    "@types/react": "^18.2.42",
    "@types/react-dom": "^18.2.17",
    "autoprefixer": "^10.5.2",
    "eslint": "^8.55.0",
    "eslint-config-next": "15.5.21",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.2",
    "vitest": "^3.2.7",
    "exceljs": "^4.4.0"
  }
}
