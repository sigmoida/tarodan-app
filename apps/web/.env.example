# =============================================================================
# Tarodan Web (storefront, Next.js) — environment template
#
# Copy to apps/web/.env.local for development. Production values live in Coolify
# and are validated by apps/web/env.config.js at startup.
#
# IMPORTANT — build-time vs runtime:
#   NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time and
#   are passed as Docker ARGs (see apps/web/Dockerfile). Changing one in Coolify
#   requires a REBUILD; a restart alone has no effect. They are also publicly
#   visible — never put a secret in a NEXT_PUBLIC_ variable.
#   Everything else is read at runtime by the Node server and stays private.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
# Set by the Dockerfile in deployments.
PORT=3000
# Server-to-server API base used by server components and route handlers. Lets
# the container reach the API over the internal network instead of the public
# hostname. Falls back to NEXT_PUBLIC_API_URL when empty.
API_INTERNAL_URL=http://localhost:3001
# true in deployments (HTTPS); false for local HTTP.
COOKIE_SECURE=false

# -----------------------------------------------------------------------------
# Public URLs and integrations (BUILD TIME — rebuild after changing)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
# WebSocket gateway. Empty derives it from NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_WS_URL=
# Optional CDN in front of S3 for product images.
NEXT_PUBLIC_ASSET_CDN_URL=
# Google Sign-In client id (web). Public by design — it ships in the client
# bundle. The value below is the shared development client; production uses its
# own id set in Coolify.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=243308404313-kdc77bd36flfhv6ujlb5tfd4qjteh94c.apps.googleusercontent.com
# Sign in with Apple.
NEXT_PUBLIC_APPLE_SERVICES_ID=
NEXT_PUBLIC_APPLE_REDIRECT_URI=
# Allow search engines to index the storefront. Keep false until launch —
# anything else emits noindex.
NEXT_PUBLIC_ALLOW_INDEXING=false

# -----------------------------------------------------------------------------
# Site lock (pre-launch gate)
# When SITE_LOCKED=true every public route redirects to /coming-soon.
# The admin app is separate and stays reachable.
# -----------------------------------------------------------------------------
SITE_LOCKED=false
# Signs the unlock cookie (valid 10 days). Must be at least 32 characters in
# production. Rotating it invalidates every issued cookie immediately.
SITE_UNLOCK_SECRET=
# Emergency unlock code that works without the API. Early-access PINs are
# managed from admin → System → Early Access.
SITE_UNLOCK_PIN=

# -----------------------------------------------------------------------------
# On-demand cache revalidation
# Must match the API's REVALIDATE_SECRET, which calls back into this app.
# -----------------------------------------------------------------------------
REVALIDATE_SECRET=

# -----------------------------------------------------------------------------
# Sentry
# -----------------------------------------------------------------------------
# Client-side DSN (build time, public).
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Derived from the git SHA by sentry.release.ts when left empty.
NEXT_PUBLIC_SENTRY_RELEASE=
# Server-side DSN (runtime, private).
SENTRY_DSN=
# Source map upload — build time only, never needed at runtime. Keep secret.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=tarodan
SENTRY_PROJECT=web

# =============================================================================
# [test] Playwright / e2e only — not required to run the app
# =============================================================================

# The e2e harness seeds and asserts directly against the database.
DATABASE_URL=
TEST_DATABASE_URL=
# Used by the checkout journey to sign a synthetic PayTR callback. These are
# read exclusively by playwright.config.ts and e2e/; they never reach the
# Next.js runtime or the client bundle.
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# Skip payment provider calls during e2e.
E2E_PAYMENT_BYPASS=
# Run the reduced journey set.
E2E_LITE=
# Reuse an already-seeded database instead of running global setup.
E2E_SKIP_SETUP=
# Local mail catcher UI polled by tests (Mailpit).
MAILHOG_URL=http://localhost:8025
# Set by CI providers; switches Playwright to its CI reporter/retry policy.
CI=
