{
  "root": true,
  "extends": ["@tarodan/eslint-config/next.json"],
  "plugins": ["@tarodan"],
  "rules": {
    "@tarodan/no-hardcoded-turkish": "error"
  },
  "overrides": [
    {
      "files": ["**/*.spec.*", "**/*.test.*"],
      "rules": { "@tarodan/no-hardcoded-turkish": "off" }
    },
    {
      "files": ["**/turkeyLocations.ts", "**/brands-data.ts"],
      "rules": { "@tarodan/no-hardcoded-turkish": "off" }
    }
  ]
}
