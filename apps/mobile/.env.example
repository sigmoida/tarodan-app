# Tarodan Mobile - environment variables
#
# Local geliştirme için bu dosyayı `.env.local` olarak kopyalayıp doldur.
# Production / preview build'lerde bu değerler EAS secret'larından enjekte edilir
# (bkz. apps/mobile/SECRETS_SETUP.md). Sadece EXPO_PUBLIC_* prefix'li değişkenler
# istemci bundle'ına dahil edilir.

# --- Çekirdek -------------------------------------------------------------

# Public API base URL. Production'da deploy edilmiş API URL'i olmak zorunda.
# Localde Expo Go LAN IP'sini otomatik çözüyoruz, boş bırakılabilir.
# Örn: https://api.tarodan.com/api
EXPO_PUBLIC_API_URL=

# Paylaşım linklerinde kullanılan web sitesi base URL'i.
# Boş bırakılırsa https://tarodan.com varsayılır (bkz. src/utils/share.ts).
EXPO_PUBLIC_WEB_URL=

# Build kanalı: development | preview | production
# eas.json zaten profil bazında setliyor; lokalde override için.
EXPO_PUBLIC_ENVIRONMENT=development

# EAS projeId - `eas init` sonrası app.json extra.eas.projectId'ye otomatik düşer.
# Push notification gönderirken kod tarafından okunuyor.
EXPO_PUBLIC_PROJECT_ID=

# --- Sentry (opsiyonel, prod'da önerilir) --------------------------------
# Sentry kurulumu için: apps/mobile/src/services/sentry.ts içindeki
# SENTRY_PACKAGE_LOADED bayrağını true yap ve @sentry/react-native paketini ekle.
EXPO_PUBLIC_SENTRY_DSN=

# --- Maestro test bypass'ı (yalnız test build'leri) ----------------------
# Production build'de KESINLIKLE setlenmemeli. EAS production profilinde
# açıkça boş tutulmalı.
EXPO_PUBLIC_MAESTRO=
EXPO_PUBLIC_MAESTRO_EMAIL=
EXPO_PUBLIC_MAESTRO_PASSWORD=
