    "@tanstack/react-query": "^5.45.0",
    "@tarodan/design-tokens": "workspace:*",
    "@tarodan/types": "workspace:*",
    "@tarodan/ui-native": "workspace:*",
    "axios": "^1.7.2",
    "date-fns": "^3.6.0",
    "expo": "~54.0.35",
    "expo-apple-authentication": "~8.0.8",
    "expo-camera": "~17.0.10",
