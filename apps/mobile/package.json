{
  "name": "@tarodan/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "eas-build-post-install": "cd ../.. && pnpm --filter @tarodan/types run build",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "maestro:dev": "bash maestro/run.sh",
    "maestro:journey1": "bash maestro/journeys/run-journey-1.sh",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "test": "jest --forceExit",
    "test:e2e": "detox test --configuration ios.sim.debug",
    "lint": "eslint . --ext .ts,.tsx",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --forceExit"
  },
  "dependencies": {
