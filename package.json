{
  "name": "tarodan",
  "version": "1.0.0",
  "private": true,
  "description": "Tarodan - İkinci El Eşya Alım Satım ve Takas Platformu",
  "scripts": {
    "start": "pnpm run docker:up; pnpm run dev",
    "dev:only": "turbo run dev",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:restart": "lsof -ti:3000 -ti:3001 -ti:3002 2>/dev/null | xargs kill -9 2>/dev/null; sleep 2; pnpm dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "pnpm --filter @tarodan/api run prisma:generate",
    "db:migrate": "pnpm --filter @tarodan/api run prisma:migrate",
    "db:migrate:deploy": "pnpm --filter @tarodan/api run prisma:migrate:deploy",
    "db:push": "pnpm --filter @tarodan/api run prisma:push",
    "db:seed": "pnpm --filter @tarodan/api run prisma:seed",
    "db:reset": "pnpm --filter @tarodan/api run prisma:migrate:reset",
    "db:studio": "pnpm --filter @tarodan/api run prisma:studio",
    "db:sync-docker": "powershell -ExecutionPolicy Bypass -File ./scripts/sync-db-docker.ps1",
    "docker:up": "docker compose -f infrastructure/docker-compose.yml up -d",
    "docker:down": "docker compose -f infrastructure/docker-compose.yml down",
    "docker:prod": "docker compose -f infrastructure/docker-compose.prod.yml up -d",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 delete all",
    "pm2:logs": "pm2 logs",
    "pm2:status": "pm2 status",
    "stack:up": "pnpm docker:up && pnpm pm2:start && echo '\\n✅ Tarodan stack ayağa kalktı: http://localhost:3000 (web), http://localhost:3001 (api), http://localhost:5601 (kibana), http://localhost:8025 (mailhog)'",
    "stack:down": "pnpm pm2:stop; pnpm docker:down",
    "stack:status": "pnpm pm2:status && docker compose -f infrastructure/docker-compose.yml ps",
    "ngrok": "./tools/ngrok http 3001",
    "postinstall": "echo Skipping husky"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "eslint": "^10.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.4",
    "turbo": "^2.10.3",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@8.12.0",
  "engines": {
    "node": ">=20.0.0 <22.0.0",
    "pnpm": ">=8.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "openai": "^6.25.0"
  },
  "pnpm": {
    "packageExtensions": {
      "react-native-worklets": {
        "dependencies": {
          "@babel/types": "^7.28.0"
        }
      }
    },
    "overrides": {
      "fast-xml-parser": ">=5.3.4",
      "handlebars": ">=4.7.9"
    }
  }
}
