{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git blame *)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list *)",
      "Bash(git rev-parse *)",
      "Bash(git rev-list *)",
      "Bash(git merge-base *)",
      "Bash(git ls-files *)",
      "Bash(git ls-tree *)",
      "Bash(git cat-file *)",
      "Bash(git worktree list *)",
      "Bash(git for-each-ref *)",
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm verify:push *)",
      "Bash(pnpm test:verification-tools)",
      "Bash(pnpm --filter @tarodan/api typecheck)",
      "Bash(pnpm --filter @tarodan/api run typecheck)",
      "Bash(pnpm --filter @tarodan/api lint)",
      "Bash(pnpm --filter @tarodan/api exec jest *)",
      "Bash(pnpm --filter @tarodan/web typecheck)",
      "Bash(pnpm --filter @tarodan/web lint)",
      "Bash(pnpm --filter @tarodan/web test:api)",
      "Bash(pnpm --filter @tarodan/web exec vitest run *)",
      "Bash(pnpm --filter @tarodan/web exec tsc --noEmit)",
      "Bash(pnpm --filter @tarodan/admin typecheck)",
      "Bash(pnpm --filter @tarodan/admin lint)",
      "Bash(pnpm --filter @tarodan/admin test:api)",
      "Bash(pnpm --filter @tarodan/admin exec vitest run *)",
      "Bash(pnpm --filter @tarodan/admin exec tsc --noEmit)",
      "Bash(pnpm --filter @tarodan/ui typecheck)",
      "Bash(pnpm --filter @tarodan/ui lint)",
      "Bash(pnpm --filter @tarodan/types typecheck)",
      "Bash(pnpm --filter @tarodan/shared typecheck)",
      "Bash(pnpm --filter @tarodan/design-tokens typecheck)",
      "Bash(pnpm --filter @tarodan/i18n codegen)",
      "Bash(pnpm --filter @tarodan/i18n build)",
      "Bash(pnpm --filter @tarodan/i18n typecheck)",
      "Bash(npx jest *)",
      "Bash(npx tsc --noEmit *)",
      "Bash(npx eslint *)",
      "Bash(npx prettier --check *)",
      "Bash(npx commitlint *)",
      "Bash(node --test *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git -C * push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh workflow run *)",
      "Bash(gh run rerun *)",
      "Bash(gh api *dispatches*)",
      "Bash(coolify *)",
      "Bash(curl *coolify*)",
      "Bash(curl *COOLIFY*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(git -C * push --force*)",
      "Bash(git -C * push * --force*)",
      "Bash(git -C * push -f*)",
      "Bash(git -C * push * -f)",
      "Bash(git -C * push * -f *)",
      "Bash(git -C * push * +*)",
      "Bash(git push --no-verify*)",
      "Bash(git push * --no-verify*)",
      "Bash(git push --delete *)",
      "Bash(git push * --delete *)",
      "Bash(git -C * push * --no-verify*)",
      "Bash(git -C * push * --delete *)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git stash *)",
      "Bash(git branch -D *)",
      "Bash(git branch * -D *)",
      "Bash(git -C * commit * --no-verify*)",
      "Bash(git -C * stash *)",
      "Bash(git -C * branch -D *)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(!**/.env.example)",
      "Read(!**/.env.test)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-generated.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/i18n-codegen.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
